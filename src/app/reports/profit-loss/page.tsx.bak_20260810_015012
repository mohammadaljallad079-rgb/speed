"use client"
export const dynamic = "force-dynamic"

import { Suspense, useState, useEffect, useRef } from 'react'
import { supabase } from '@/lib/supabase'
import { formatCurrency } from '@/lib/utils'
import DashboardLayout from '@/components/DashboardLayout'
import { useLanguage } from '@/lib/LanguageContext'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { 
  Loader2, TrendingUp, TrendingDown, DollarSign, Calendar, 
  Printer, Download, FileSpreadsheet, ChevronDown, ChevronUp 
} from 'lucide-react'

interface PLItem {
  code: string
  name: string
  name_en: string
  balance: number
  isSubAccount?: boolean
}

interface PLSection {
  title: string
  titleAr: string
  items: PLItem[]
  total: number
  color: string
}

function ProfitLossContent() {
  const { isRTL } = useLanguage()
  const printRef = useRef<HTMLDivElement>(null)
  
  const [loading, setLoading] = useState(true)
  const [dateFrom, setDateFrom] = useState('')
  const [dateTo, setDateTo] = useState('')
  const [sections, setSections] = useState<PLSection[]>([])
  const [grossProfit, setGrossProfit] = useState(0)
  const [netProfit, setNetProfit] = useState(0)
  const [expandedSections, setExpandedSections] = useState<Set<string>>(new Set(['revenue', 'cogs', 'opex']))

  useEffect(() => {
    fetchData()
  }, [dateFrom, dateTo])

  async function fetchData() {
    setLoading(true)
    try {
      // 1. Get all revenue and expense accounts
      const { data: accounts, error: accError } = await supabase
        .from('accounts')
        .select('id, code, name, name_en, type, parent_code, level')
        .in('type', ['revenue', 'expense'])
        .eq('is_active', true)
        .order('code')

      if (accError) throw accError
      if (!accounts || accounts.length === 0) {
        setLoading(false)
        return
      }

      // 2. Get journal entry lines with date filter
      let query = supabase
        .from('journal_entry_lines')
        .select(`
          account_id,
          debit,
          credit,
          journal_entries!inner(entry_date, status)
        `)
        .eq('journal_entries.status', 'posted')

      if (dateFrom) query = query.gte('journal_entries.entry_date', dateFrom)
      if (dateTo) query = query.lte('journal_entries.entry_date', dateTo)

      const { data: lines, error: linesError } = await query
      if (linesError) throw linesError

      // 3. Calculate balances per account
      const balances: Record<string, { debit: number; credit: number }> = {}
      accounts.forEach(a => {
        balances[a.id] = { debit: 0, credit: 0 }
      })

      ;(lines || []).forEach((line: any) => {
        if (balances[line.account_id]) {
          balances[line.account_id].debit += parseFloat(line.debit || 0)
          balances[line.account_id].credit += parseFloat(line.credit || 0)
        }
      })

      // 4. Build account items with proper balance calculation
      const allItems: PLItem[] = accounts.map((acc: any) => {
        const b = balances[acc.id] || { debit: 0, credit: 0 }
        // Revenue: credit increases (credit - debit)
        // Expense: debit increases (debit - credit)
        const balance = acc.type === 'revenue' 
          ? b.credit - b.debit 
          : b.debit - b.credit
        
        return {
          code: acc.code,
          name: acc.name,
          name_en: acc.name_en || acc.name,
          balance: Math.abs(balance) > 0.001 ? balance : 0,
          isSubAccount: acc.level > 1 || acc.parent_code !== null
        }
      }).filter(item => item.balance !== 0)

      // 5. Categorize sections
      const revenueItems = allItems.filter(a => a.code.startsWith('4') || a.code.startsWith('5') === false && a.balance > 0)
        .sort((a, b) => a.code.localeCompare(b.code))
      
      const cogsItems = allItems.filter(a => a.code.startsWith('510'))
        .sort((a, b) => a.code.localeCompare(b.code))
      
      const opexItems = allItems.filter(a => a.type === 'expense' && !a.code.startsWith('510'))
        .sort((a, b) => a.code.localeCompare(b.code))

      const totalRev = revenueItems.reduce((s, i) => s + i.balance, 0)
      const totalCogs = cogsItems.reduce((s, i) => s + Math.abs(i.balance), 0)
      const totalOpex = opexItems.reduce((s, i) => s + Math.abs(i.balance), 0)

      setSections([
        {
          title: 'Revenue',
          titleAr: 'الإيرادات',
          items: revenueItems,
          total: totalRev,
          color: 'emerald'
        },
        {
          title: 'Direct Cost of Sales',
          titleAr: 'تكلفة المبيعات المباشرة',
          items: cogsItems,
          total: totalCogs,
          color: 'amber'
        },
        {
          title: 'Operating Expenses',
          titleAr: 'مصاريف التشغيل',
          items: opexItems,
          total: totalOpex,
          color: 'red'
        }
      ])

      setGrossProfit(totalRev - totalCogs)
      setNetProfit(totalRev - totalCogs - totalOpex)

    } catch (error) {
      console.error('P&L Error:', error)
    }
    setLoading(false)
  }

  function toggleSection(key: string) {
    const next = new Set(expandedSections)
    if (next.has(key)) next.delete(key)
    else next.add(key)
    setExpandedSections(next)
  }

  function handlePrint() {
    if (printRef.current) {
      const printWindow = window.open('', '_blank')
      if (printWindow) {
        printWindow.document.write(`
          <html>
            <head><title>Profit & Loss Statement</title>
            <style>
              body { font-family: Arial; padding: 40px; max-width: 800px; margin: 0 auto; }
              h1 { text-align: center; border-bottom: 2px solid #333; padding-bottom: 10px; }
              .section { margin: 20px 0; }
              .section-title { font-weight: bold; font-size: 14px; text-transform: uppercase; border-bottom: 1px solid #ccc; padding: 8px 0; background: #f5f5f5; }
              .item { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px dotted #ddd; }
              .sub { padding-left: 30px; font-size: 13px; color: #555; }
              .total { display: flex; justify-content: space-between; font-weight: bold; padding: 10px 0; border-top: 2px solid #333; margin-top: 5px; }
              .profit-box { background: #e8f5e9; padding: 20px; border-radius: 8px; text-align: center; margin: 20px 0; border: 2px solid #4caf50; }
              .profit-box.negative { background: #ffebee; border-color: #f44336; }
              .profit-box h2 { margin: 0; font-size: 28px; }
              .date-range { text-align: center; color: #666; margin-bottom: 20px; }
              @media print { .no-print { display: none; } }
            </style>
            </head>
            <body>
              <h1>Profit & Loss Statement</h1>
              <div class="date-range">Period: ${dateFrom || 'All time'} to ${dateTo || 'Today'}</div>
              ${printRef.current.innerHTML}
            </body>
          </html>
        `)
        printWindow.document.close()
        printWindow.print()
      }
    }
  }

  function handleExport() {
    // Build CSV
    const rows: string[][] = [
      ['#', 'Code', 'Account', 'Amount (BHD)']
    ]
    
    let rowNum = 1
    sections.forEach(sec => {
      rows.push([String(rowNum++), '', sec.title.toUpperCase(), ''])
      sec.items.forEach(item => {
        rows.push([String(rowNum++), item.code, item.isSubAccount ? `  ${item.name_en}` : item.name_en, item.balance.toFixed(3)])
      })
      rows.push([String(rowNum++), '', `Total ${sec.title}`, sec.total.toFixed(3)])
      rows.push(['', '', '', ''])
    })
    
    rows.push([String(rowNum++), '', 'GROSS PROFIT', grossProfit.toFixed(3)])
    rows.push([String(rowNum++), '', 'NET PROFIT', netProfit.toFixed(3)])

    const csv = rows.map(r => r.map(c => `"${String(c).replace(/"/g, '""')}"`).join(',')).join('\n')
    const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' })
    const url = URL.createObjectURL(blob)
    const a = document.createElement('a')
    a.href = url
    a.download = `P&L_${dateFrom || 'all'}_${dateTo || 'today'}.csv`
    document.body.appendChild(a)
    a.click()
    document.body.removeChild(a)
    URL.revokeObjectURL(url)
  }

  const colorMap: Record<string, { bg: string; text: string; border: string; light: string }> = {
    emerald: { bg: 'bg-emerald-50', text: 'text-emerald-700', border: 'border-emerald-200', light: 'text-emerald-600' },
    amber: { bg: 'bg-amber-50', text: 'text-amber-700', border: 'border-amber-200', light: 'text-amber-600' },
    red: { bg: 'bg-red-50', text: 'text-red-700', border: 'border-red-200', light: 'text-red-600' },
  }

  if (loading) {
    return (
      <DashboardLayout>
        <div className="flex items-center justify-center h-64">
          <Loader2 className="w-8 h-8 animate-spin text-indigo-500" />
        </div>
      </DashboardLayout>
    )
  }

  return (
    <DashboardLayout>
      <div className="max-w-5xl mx-auto p-4 space-y-6" dir={isRTL ? 'rtl' : 'ltr'}>
        
        {/* Header with Actions */}
        <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <h1 className="text-2xl font-bold text-slate-900 dark:text-white flex items-center gap-2">
              <TrendingUp className="w-7 h-7 text-emerald-500" /> 
              {isRTL ? 'قائمة الدخل' : 'Profit & Loss Statement'}
            </h1>
            <p className="text-sm text-slate-500 mt-1">
              {isRTL ? 'تقرير الأرباح والخسائر' : 'Income Statement Report'}
            </p>
          </div>
          <div className="flex gap-2">
            <Button variant="outline" size="sm" onClick={handleExport} className="gap-1.5 rounded-lg">
              <FileSpreadsheet className="w-4 h-4" /> Excel
            </Button>
            <Button variant="outline" size="sm" onClick={handlePrint} className="gap-1.5 rounded-lg">
              <Printer className="w-4 h-4" /> {isRTL ? 'طباعة' : 'Print'}
            </Button>
          </div>
        </div>

        {/* Date Filter */}
        <Card className="rounded-xl border border-slate-200 dark:border-slate-700 shadow-sm">
          <CardContent className="p-4">
            <div className="flex items-center gap-3 flex-wrap">
              <Calendar className="w-5 h-5 text-slate-400" />
              <div className="flex gap-3 flex-wrap">
                <div>
                  <Label className="text-xs text-slate-500 mb-1 block">{isRTL ? 'من تاريخ' : 'From'}</Label>
                  <Input type="date" value={dateFrom} onChange={e => setDateFrom(e.target.value)} className="h-9 rounded-lg w-44" />
                </div>
                <div>
                  <Label className="text-xs text-slate-500 mb-1 block">{isRTL ? 'إلى تاريخ' : 'To'}</Label>
                  <Input type="date" value={dateTo} onChange={e => setDateTo(e.target.value)} className="h-9 rounded-lg w-44" />
                </div>
                <div className="flex items-end">
                  <Button size="sm" onClick={fetchData} className="h-9 rounded-lg bg-indigo-500 hover:bg-indigo-600 text-white">
                    <Download className="w-4 h-4 mr-1" /> {isRTL ? 'تحديث' : 'Refresh'}
                  </Button>
                </div>
              </div>
            </div>
          </CardContent>
        </Card>

        {/* Print Area */}
        <div ref={printRef} className="space-y-4">
          
          {/* Sections */}
          {sections.map(sec => {
            const c = colorMap[sec.color]
            const isOpen = expandedSections.has(sec.title)
            
            return (
              <Card key={sec.title} className={`rounded-xl border ${c.border} shadow-sm overflow-hidden`}>
                <CardHeader 
                  className={`${c.bg} py-3 cursor-pointer select-none`}
                  onClick={() => toggleSection(sec.title)}
                >
                  <CardTitle className={`text-sm font-bold ${c.text} uppercase tracking-wider flex items-center justify-between`}>
                    <span className="flex items-center gap-2">
                      {sec.title === 'Revenue' && <DollarSign className="w-4 h-4" />}
                      {sec.title === 'Direct Cost of Sales' && <TrendingDown className="w-4 h-4" />}
                      {sec.title === 'Operating Expenses' && <TrendingDown className="w-4 h-4" />}
                      {isRTL ? sec.titleAr : sec.title}
                    </span>
                    <div className="flex items-center gap-3">
                      <span className={`text-lg ${c.light}`}>{formatCurrency(sec.total)}</span>
                      {isOpen ? <ChevronUp className="w-4 h-4" /> : <ChevronDown className="w-4 h-4" />}
                    </div>
                  </CardTitle>
                </CardHeader>
                
                {isOpen && (
                  <CardContent className="p-0">
                    {sec.items.length === 0 ? (
                      <div className="p-4 text-center text-sm text-slate-400">
                        {isRTL ? 'لا توجد بيانات' : 'No data'}
                      </div>
                    ) : (
                      <div className="divide-y divide-slate-100 dark:divide-slate-700/50">
                        {sec.items.map(item => (
                          <div 
                            key={item.code} 
                            className={`flex justify-between items-center py-2.5 px-4 hover:bg-slate-50 dark:hover:bg-slate-700/30 transition-colors ${
                              item.isSubAccount ? 'pl-10' : ''
                            }`}
                          >
                            <div className="flex items-center gap-2">
                              <span className="text-xs font-mono text-slate-400 w-14">{item.code}</span>
                              <span className={`text-sm ${item.isSubAccount ? 'text-slate-500' : 'font-medium text-slate-700 dark:text-slate-200'}`}>
                                {isRTL ? item.name : item.name_en}
                              </span>
                            </div>
                            <span className={`text-sm font-bold font-mono tabular-nums ${
                              sec.color === 'emerald' ? 'text-emerald-600' : 'text-red-500'
                            }`}>
                              {formatCurrency(Math.abs(item.balance))}
                            </span>
                          </div>
                        ))}
                      </div>
                    )}
                    <div className={`flex justify-between items-center py-3 px-4 ${c.bg} border-t ${c.border}`}>
                      <span className="font-bold text-sm text-slate-700 dark:text-slate-200">
                        {isRTL ? 'الإجمالي' : `Total ${sec.title}`}
                      </span>
                      <span className={`font-bold text-lg font-mono tabular-nums ${c.light}`}>
                        {formatCurrency(sec.total)}
                      </span>
                    </div>
                  </CardContent>
                )}
              </Card>
            )
          })}

          {/* Gross Profit */}
          <Card className={`rounded-xl border-2 ${grossProfit >= 0 ? 'border-emerald-300 bg-gradient-to-r from-emerald-50 to-green-50' : 'border-red-300 bg-gradient-to-r from-red-50 to-orange-50'} dark:border-slate-700 shadow-md`}>
            <CardContent className="p-5">
              <div className="flex justify-between items-center">
                <div>
                  <p className="text-sm font-semibold text-slate-600 dark:text-slate-300 uppercase tracking-wide">
                    {isRTL ? 'إجمالي الربح' : 'Gross Profit'}
                  </p>
                  <p className="text-xs text-slate-400 mt-0.5">
                    {isRTL ? 'الإيرادات - تكلفة المبيعات' : 'Revenue - Cost of Sales'}
                  </p>
                </div>
                <span className={`font-bold text-2xl font-mono tabular-nums ${grossProfit >= 0 ? 'text-emerald-600' : 'text-red-600'}`}>
                  {formatCurrency(grossProfit)}
                </span>
              </div>
            </CardContent>
          </Card>

          {/* Net Profit */}
          <Card className={`rounded-xl border-2 ${netProfit >= 0 ? 'border-emerald-400 bg-gradient-to-br from-emerald-100 to-green-100' : 'border-red-400 bg-gradient-to-br from-red-100 to-orange-100'} dark:border-slate-700 shadow-lg`}>
            <CardContent className="p-6">
              <div className="flex justify-between items-center">
                <div>
                  <p className="text-base font-bold text-slate-800 dark:text-white uppercase tracking-wide">
                    {isRTL ? 'صافي الربح' : 'Net Profit / Loss'}
                  </p>
                  <p className="text-xs text-slate-500 mt-1">
                    {isRTL ? 'إجمالي الربح - المصاريف التشغيلية' : 'Gross Profit - Operating Expenses'}
                  </p>
                </div>
                <span className={`font-bold text-4xl font-mono tabular-nums ${netProfit >= 0 ? 'text-emerald-700' : 'text-red-700'}`}>
                  {formatCurrency(netProfit)}
                </span>
              </div>
            </CardContent>
          </Card>

        </div>
      </div>
    </DashboardLayout>
  )
}

export default function Page() {
  return (
    <Suspense fallback={<div className="flex items-center justify-center h-64"><Loader2 className="w-8 h-8 animate-spin text-indigo-500" /></div>}>
      <ProfitLossContent />
    </Suspense>
  )
}
