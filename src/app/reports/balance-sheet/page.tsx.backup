"use client"
import { Suspense, useState, useEffect } from 'react'
export const dynamic = "force-dynamic"
import { supabase } from '@/lib/supabase'
import DashboardLayout from '@/components/DashboardLayout'
import { useLanguage } from '@/lib/LanguageContext'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { Badge } from '@/components/ui/badge'
import { Building2, Download, Calendar, ArrowLeft, TrendingUp, TrendingDown, Scale } from 'lucide-react'
import { useRouter } from 'next/navigation'
import * as XLSX from 'xlsx'

interface BSRow {
  account_code: string
  account_name: string
  account_name_ar: string
  amount: number
  section: 'asset' | 'liability' | 'equity'
}

function BalanceSheetContent() {
  const { isRTL } = useLanguage()
  const router = useRouter()
  const [assets, setAssets] = useState<BSRow[]>([])
  const [liabilities, setLiabilities] = useState<BSRow[]>([])
  const [equity, setEquity] = useState<BSRow[]>([])
  const [loading, setLoading] = useState(true)
  const [asOfDate, setAsOfDate] = useState(new Date().toISOString().split('T')[0])

  useEffect(() => {
    loadData()
  }, [asOfDate])

  async function loadData() {
    setLoading(true)
    try {
      const { data: accounts } = await supabase
        .from('chart_of_accounts')
        .select('*')
        .in('account_type', ['asset', 'liability', 'equity'])

      const { data: entries } = await supabase
        .from('journal_entries')
        .select('*')
        .lte('date', asOfDate)

      const assetRows: BSRow[] = []
      const liabilityRows: BSRow[] = []
      const equityRows: BSRow[] = []

      ;(accounts || []).forEach((acc: any) => {
        const accEntries = (entries || []).filter((e: any) => e.account_id === acc.id)
        const debit = accEntries.reduce((s: number, e: any) => s + Number(e.debit || 0), 0)
        const credit = accEntries.reduce((s: number, e: any) => s + Number(e.credit || 0), 0)

        let amount = 0
        if (acc.account_type === 'asset') {
          amount = debit - credit
        } else {
          amount = credit - debit
        }

        if (amount !== 0) {
          const row = {
            account_code: acc.account_code || '',
            account_name: acc.account_name || '',
            account_name_ar: acc.account_name_ar || acc.account_name || '',
            amount,
            section: acc.account_type
          }
          if (acc.account_type === 'asset') assetRows.push(row)
          else if (acc.account_type === 'liability') liabilityRows.push(row)
          else if (acc.account_type === 'equity') equityRows.push(row)
        }
      })

      setAssets(assetRows)
      setLiabilities(liabilityRows)
      setEquity(equityRows)
    } catch (err) {
      console.error(err)
    } finally {
      setLoading(false)
    }
  }

  const totalAssets = assets.reduce((s, r) => s + r.amount, 0)
  const totalLiabilities = liabilities.reduce((s, r) => s + r.amount, 0)
  const totalEquity = equity.reduce((s, r) => s + r.amount, 0)
  const totalLiabilitiesEquity = totalLiabilities + totalEquity
  const isBalanced = Math.abs(totalAssets - totalLiabilitiesEquity) < 0.01

  function exportExcel() {
    const exportData = [
      { Section: 'ASSETS', Account: '', Amount: '' },
      ...assets.map(r => ({ Section: '', Account: isRTL ? r.account_name_ar : r.account_name, Amount: r.amount })),
      { Section: '', Account: 'TOTAL ASSETS', Amount: totalAssets },
      { Section: '', Account: '', Amount: '' },
      { Section: 'LIABILITIES', Account: '', Amount: '' },
      ...liabilities.map(r => ({ Section: '', Account: isRTL ? r.account_name_ar : r.account_name, Amount: r.amount })),
      { Section: '', Account: 'TOTAL LIABILITIES', Amount: totalLiabilities },
      { Section: '', Account: '', Amount: '' },
      { Section: 'EQUITY', Account: '', Amount: '' },
      ...equity.map(r => ({ Section: '', Account: isRTL ? r.account_name_ar : r.account_name, Amount: r.amount })),
      { Section: '', Account: 'TOTAL EQUITY', Amount: totalEquity },
      { Section: '', Account: 'TOTAL L + E', Amount: totalLiabilitiesEquity }
    ]
    const ws = XLSX.utils.json_to_sheet(exportData)
    const wb = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(wb, ws, 'Balance Sheet')
    XLSX.writeFile(wb, `Balance_Sheet_${asOfDate}.xlsx`)
  }

  return (
    <DashboardLayout>
      <div className="min-h-screen bg-[#f0f2f5]" dir={isRTL ? "rtl" : "ltr"}>
        <div className="p-6 max-w-5xl mx-auto space-y-6">
          {/* Header */}
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              <Button variant="outline" size="icon" onClick={() => router.back()} className="rounded-lg">
                <ArrowLeft className={isRTL ? 'rotate-180' : ''} />
              </Button>
              <div>
                <h1 className="text-2xl font-black text-slate-900">
                  {isRTL ? 'الميزانية العمومية' : 'Balance Sheet'}
                </h1>
                <p className="text-sm text-slate-500">
                  {isRTL ? 'الأصول والخصوم وحقوق الملكية' : 'Assets, liabilities and equity'}
                </p>
              </div>
            </div>
            <Button onClick={exportExcel} className="bg-emerald-600 hover:bg-emerald-700 rounded-xl">
              <Download className="w-4 h-4 mr-2" />
              {isRTL ? 'تصدير Excel' : 'Export Excel'}
            </Button>
          </div>

          {/* Date Filter */}
          <Card className="border-0 shadow-md">
            <CardContent className="p-4">
              <div className="flex flex-col md:flex-row gap-4">
                <div className="flex-1">
                  <Label className="text-xs text-slate-500 mb-1 block">{isRTL ? 'تاريخ' : 'As of Date'}</Label>
                  <div className="relative">
                    <Calendar className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
                    <Input type="date" value={asOfDate} onChange={e => setAsOfDate(e.target.value)} className="pl-10 rounded-lg" />
                  </div>
                </div>
                <div className="flex items-end">
                  <Badge className={`px-4 py-2 text-sm ${isBalanced ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'}`}>
                    <Scale className="w-4 h-4 mr-1" />
                    {isBalanced ? (isRTL ? 'متوازنة' : 'Balanced') : (isRTL ? 'غير متوازنة!' : 'Unbalanced!')}
                  </Badge>
                </div>
              </div>
            </CardContent>
          </Card>

          {/* Summary Cards */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <Card className="border-0 shadow-md bg-gradient-to-br from-blue-50 to-white">
              <CardContent className="p-4">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center">
                    <TrendingUp className="w-5 h-5 text-blue-600" />
                  </div>
                  <div>
                    <p className="text-xs text-slate-500">{isRTL ? 'إجمالي الأصول' : 'Total Assets'}</p>
                    <p className="text-xl font-black text-blue-600">{totalAssets.toFixed(3)} BHD</p>
                  </div>
                </div>
              </CardContent>
            </Card>
            <Card className="border-0 shadow-md bg-gradient-to-br from-red-50 to-white">
              <CardContent className="p-4">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center">
                    <TrendingDown className="w-5 h-5 text-red-600" />
                  </div>
                  <div>
                    <p className="text-xs text-slate-500">{isRTL ? 'إجمالي الخصوم' : 'Total Liabilities'}</p>
                    <p className="text-xl font-black text-red-600">{totalLiabilities.toFixed(3)} BHD</p>
                  </div>
                </div>
              </CardContent>
            </Card>
            <Card className="border-0 shadow-md bg-gradient-to-br from-violet-50 to-white">
              <CardContent className="p-4">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-violet-100 flex items-center justify-center">
                    <Building2 className="w-5 h-5 text-violet-600" />
                  </div>
                  <div>
                    <p className="text-xs text-slate-500">{isRTL ? 'حقوق الملكية' : 'Total Equity'}</p>
                    <p className="text-xl font-black text-violet-600">{totalEquity.toFixed(3)} BHD</p>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>

          {/* Balance Sheet Statement */}
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {/* Left Side - Assets */}
            <Card className="border-0 shadow-md overflow-hidden">
              <CardHeader className="bg-gradient-to-r from-blue-600 to-blue-700 text-white">
                <CardTitle className="flex items-center gap-2 text-base">
                  <TrendingUp className="w-5 h-5" />
                  {isRTL ? 'الأصول' : 'ASSETS'}
                </CardTitle>
              </CardHeader>
              <CardContent className="p-0">
                {loading ? (
                  <div className="p-8 text-center text-slate-400">{isRTL ? 'جاري التحميل...' : 'Loading...'}</div>
                ) : assets.length === 0 ? (
                  <div className="p-8 text-center text-slate-400">{isRTL ? 'لا توجد أصول' : 'No assets'}</div>
                ) : (
                  <div className="p-4 space-y-1">
                    {assets.map((r, i) => (
                      <div key={i} className="flex justify-between items-center py-2 px-3 rounded-lg hover:bg-slate-50">
                        <div>
                          <p className="text-sm font-semibold text-slate-800">{isRTL ? r.account_name_ar : r.account_name}</p>
                          <p className="text-xs text-slate-400 font-mono">{r.account_code}</p>
                        </div>
                        <p className="text-sm font-bold text-blue-600 font-mono">{r.amount.toFixed(3)}</p>
                      </div>
                    ))}
                    <div className="flex justify-between items-center py-3 px-3 bg-blue-50 rounded-xl mt-3 border-t-2 border-blue-200">
                      <p className="text-sm font-bold text-blue-800">{isRTL ? 'إجمالي الأصول' : 'Total Assets'}</p>
                      <p className="text-lg font-black text-blue-700 font-mono">{totalAssets.toFixed(3)} BHD</p>
                    </div>
                  </div>
                )}
              </CardContent>
            </Card>

            {/* Right Side - Liabilities + Equity */}
            <div className="space-y-6">
              {/* Liabilities */}
              <Card className="border-0 shadow-md overflow-hidden">
                <CardHeader className="bg-gradient-to-r from-red-600 to-red-700 text-white">
                  <CardTitle className="flex items-center gap-2 text-base">
                    <TrendingDown className="w-5 h-5" />
                    {isRTL ? 'الخصوم' : 'LIABILITIES'}
                  </CardTitle>
                </CardHeader>
                <CardContent className="p-0">
                  {loading ? (
                    <div className="p-8 text-center text-slate-400">{isRTL ? 'جاري التحميل...' : 'Loading...'}</div>
                  ) : liabilities.length === 0 ? (
                    <div className="p-8 text-center text-slate-400">{isRTL ? 'لا توجد خصوم' : 'No liabilities'}</div>
                  ) : (
                    <div className="p-4 space-y-1">
                      {liabilities.map((r, i) => (
                        <div key={i} className="flex justify-between items-center py-2 px-3 rounded-lg hover:bg-slate-50">
                          <div>
                            <p className="text-sm font-semibold text-slate-800">{isRTL ? r.account_name_ar : r.account_name}</p>
                            <p className="text-xs text-slate-400 font-mono">{r.account_code}</p>
                          </div>
                          <p className="text-sm font-bold text-red-600 font-mono">{r.amount.toFixed(3)}</p>
                        </div>
                      ))}
                      <div className="flex justify-between items-center py-3 px-3 bg-red-50 rounded-xl mt-3 border-t-2 border-red-200">
                        <p className="text-sm font-bold text-red-800">{isRTL ? 'إجمالي الخصوم' : 'Total Liabilities'}</p>
                        <p className="text-lg font-black text-red-700 font-mono">{totalLiabilities.toFixed(3)} BHD</p>
                      </div>
                    </div>
                  )}
                </CardContent>
              </Card>

              {/* Equity */}
              <Card className="border-0 shadow-md overflow-hidden">
                <CardHeader className="bg-gradient-to-r from-violet-600 to-violet-700 text-white">
                  <CardTitle className="flex items-center gap-2 text-base">
                    <Building2 className="w-5 h-5" />
                    {isRTL ? 'حقوق الملكية' : 'EQUITY'}
                  </CardTitle>
                </CardHeader>
                <CardContent className="p-0">
                  {loading ? (
                    <div className="p-8 text-center text-slate-400">{isRTL ? 'جاري التحميل...' : 'Loading...'}</div>
                  ) : equity.length === 0 ? (
                    <div className="p-8 text-center text-slate-400">{isRTL ? 'لا توجد حقوق ملكية' : 'No equity'}</div>
                  ) : (
                    <div className="p-4 space-y-1">
                      {equity.map((r, i) => (
                        <div key={i} className="flex justify-between items-center py-2 px-3 rounded-lg hover:bg-slate-50">
                          <div>
                            <p className="text-sm font-semibold text-slate-800">{isRTL ? r.account_name_ar : r.account_name}</p>
                            <p className="text-xs text-slate-400 font-mono">{r.account_code}</p>
                          </div>
                          <p className="text-sm font-bold text-violet-600 font-mono">{r.amount.toFixed(3)}</p>
                        </div>
                      ))}
                      <div className="flex justify-between items-center py-3 px-3 bg-violet-50 rounded-xl mt-3 border-t-2 border-violet-200">
                        <p className="text-sm font-bold text-violet-800">{isRTL ? 'إجمالي حقوق الملكية' : 'Total Equity'}</p>
                        <p className="text-lg font-black text-violet-700 font-mono">{totalEquity.toFixed(3)} BHD</p>
                      </div>
                    </div>
                  )}
                </CardContent>
              </Card>

              {/* Total L + E */}
              <div className={`p-4 rounded-2xl ${isBalanced ? 'bg-gradient-to-r from-emerald-50 to-blue-50 border-2 border-emerald-300' : 'bg-gradient-to-r from-red-50 to-amber-50 border-2 border-red-300'}`}>
                <div className="flex justify-between items-center">
                  <div>
                    <p className="text-sm font-bold text-slate-700">{isRTL ? 'إجمالي الخصوم + حقوق الملكية' : 'Total Liabilities + Equity'}</p>
                    <p className="text-xs text-slate-500">{isRTL ? 'يجب أن يساوي إجمالي الأصول' : 'Must equal Total Assets'}</p>
                  </div>
                  <p className={`text-2xl font-black font-mono ${isBalanced ? 'text-emerald-600' : 'text-red-600'}`}>
                    {totalLiabilitiesEquity.toFixed(3)} BHD
                  </p>
                </div>
                {!isBalanced && (
                  <p className="text-xs text-red-500 mt-2 font-bold">
                    {isRTL ? `فرق: ${(totalAssets - totalLiabilitiesEquity).toFixed(3)} BHD` : `Difference: ${(totalAssets - totalLiabilitiesEquity).toFixed(3)} BHD`}
                  </p>
                )}
              </div>
            </div>
          </div>
        </div>
      </div>
    </DashboardLayout>
  )
}

export default function BalanceSheetPage() {
  return (
    <Suspense fallback={<div className="min-h-screen bg-[#f0f2f5] flex items-center justify-center"><div className="w-10 h-10 bg-slate-800 rounded-xl animate-pulse" /></div>}>
      <BalanceSheetContent />
    </Suspense>
  )
}
