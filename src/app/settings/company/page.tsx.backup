"use client"
import { Suspense } from 'react'
import { } from 'react'
export const dynamic = "force-dynamic"

import { useEffect, useState } from 'react'
import DashboardLayout from '@/components/DashboardLayout'
import { Language } from '@/lib/i18n'
import { useLanguage } from '@/lib/LanguageContext'
import { supabase } from '@/lib/supabase'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { Textarea } from '@/components/ui/textarea'
import { Card, CardHeader, CardTitle, CardContent, CardFooter } from '@/components/ui/card'
import { Badge } from '@/components/ui/badge'
import { Globe, Image as ImageIcon, Info, Phone, Mail, MapPin, FileText, Plus } from 'lucide-react'

function WebsiteSettingsContent() {
  const { lang, t, isRTL } = useLanguage()
  const [loading, setLoading] = useState(true)
  const [saved, setSaved] = useState(false)
  const [company, setCompany] = useState({
    name: '',
    phone: '',
    email: '',
    address: '',
    crNumber: '',
  })
  const [contracts, setContracts] = useState({
    rentalTerms: '',
    rentalClauses: '',
    salesTerms: '',
    salesClauses: '',
  })

  useEffect(() => {
    fetchSettings()
  }, [])

  const fetchSettings = async () => {
    setLoading(true)
    const { data } = await supabase
      .from('settings')
      .select('*')
      .in('key', ['company_profile', 'contract_defaults'])

    const companySetting = data?.find((item) => item.key === 'company_profile')
    const contractSetting = data?.find((item) => item.key === 'contract_defaults')

    if (companySetting?.value) {
      setCompany({
        name: companySetting.value.name || '',
        phone: companySetting.value.phone || '',
        email: companySetting.value.email || '',
        address: companySetting.value.address || '',
        crNumber: companySetting.value.crNumber || '',
      })
    }

    if (contractSetting?.value) {
      setContracts({
        rentalTerms: contractSetting.value.rentalTerms || '',
        rentalClauses: contractSetting.value.rentalClauses || '',
        salesTerms: contractSetting.value.salesTerms || '',
        salesClauses: contractSetting.value.salesClauses || '',
      })
    }

    setLoading(false)
  }

  const handleSave = async () => {
    await supabase.from('settings').upsert(
      {
        key: 'company_profile',
        value: company,
        updated_at: new Date().toISOString(),
      },
      { onConflict: 'key' }
    )

    await supabase.from('settings').upsert(
      {
        key: 'contract_defaults',
        value: contracts,
        updated_at: new Date().toISOString(),
      },
      { onConflict: 'key' }
    )

    setSaved(true)
    setTimeout(() => setSaved(false), 2000)
  }

  return (
    <DashboardLayout>
      <div className="max-w-4xl mx-auto space-y-6">
        <div className="flex items-center justify-between">
          <h1 className="text-2xl font-bold text-slate-900 dark:text-white">{t.websiteSettings}</h1>
          <div className="flex items-center gap-3">
            {saved && <Badge className="bg-emerald-100 text-emerald-700">تم الحفظ</Badge>}
            <Button onClick={handleSave} className="bg-cyan-500 hover:bg-cyan-600 text-white font-bold px-8" disabled={loading}>
              {t.save}
            </Button>
          </div>
        </div>

        <div className="grid gap-6">
          <Card className="border-slate-200 dark:border-slate-800 shadow-sm">
            <CardHeader className="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50">
              <CardTitle className="text-lg flex items-center gap-2">
                <ImageIcon className="w-5 h-5 text-cyan-500" />
                <span>الصور والشرائح (Slideshow)</span>
              </CardTitle>
            </CardHeader>
            <CardContent className="pt-6 space-y-4">
              <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
                {[1, 2, 3, 4].map(i => (
                  <div key={i} className="aspect-video rounded-xl border-2 border-dashed border-slate-200 dark:border-slate-700 flex flex-col items-center justify-center gap-2 hover:border-cyan-500/50 transition-colors cursor-pointer bg-slate-50 dark:bg-slate-900/50 group">
                    <div className="w-10 h-10 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-400 group-hover:text-cyan-500 group-hover:bg-cyan-50 transition-all">
                      <Plus className="w-5 h-5" />
                    </div>
                    <span className="text-xs font-medium text-slate-500">تحميل صورة {i}</span>
                  </div>
                ))}
              </div>
            </CardContent>
          </Card>

          <Card className="border-slate-200 dark:border-slate-800 shadow-sm">
            <CardHeader className="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50">
              <CardTitle className="text-lg flex items-center gap-2">
                <Info className="w-5 h-5 text-violet-500" />
                <span>معلومات عنا (About Us)</span>
              </CardTitle>
            </CardHeader>
            <CardContent className="pt-6 space-y-4">
              <div className="space-y-2">
                <Label>من نحن</Label>
                <Textarea placeholder="اكتب نبذة عن الشركة هنا..." className="min-h-[120px]" />
              </div>
              <div className="space-y-2">
                <Label>رؤيتنا</Label>
                <Textarea placeholder="اكتب رؤية الشركة هنا..." className="min-h-[100px]" />
              </div>
            </CardContent>
          </Card>

          <Card className="border-slate-200 dark:border-slate-800 shadow-sm">
            <CardHeader className="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50">
              <CardTitle className="text-lg flex items-center gap-2">
                <Phone className="w-5 h-5 text-emerald-500" />
                <span>معلومات التواصل (Contact Us)</span>
              </CardTitle>
            </CardHeader>
            <CardContent className="pt-6 grid lg:grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label className="flex items-center gap-2">
                  <Phone className="w-4 h-4 text-slate-400" />
                  رقم الهاتف
                </Label>
                <Input
                  placeholder="+973 XXXXXXXX"
                  value={company.phone}
                  onChange={(event) => setCompany({ ...company, phone: event.target.value })}
                />
              </div>
              <div className="space-y-2">
                <Label className="flex items-center gap-2">
                  <Mail className="w-4 h-4 text-slate-400" />
                  البريد الإلكتروني
                </Label>
                <Input
                  placeholder="info@example.com"
                  value={company.email}
                  onChange={(event) => setCompany({ ...company, email: event.target.value })}
                />
              </div>
              <div className="space-y-2 lg:col-span-2">
                <Label className="flex items-center gap-2">
                  <MapPin className="w-4 h-4 text-slate-400" />
                  العنوان
                </Label>
                <Input
                  placeholder="المنامة، البحرين"
                  value={company.address}
                  onChange={(event) => setCompany({ ...company, address: event.target.value })}
                />
              </div>
            </CardContent>
          </Card>

          <Card className="border-slate-200 dark:border-slate-800 shadow-sm">
            <CardHeader className="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50">
              <CardTitle className="text-lg flex items-center gap-2">
                <Globe className="w-5 h-5 text-cyan-500" />
                <span>بيانات الشركة للاتفاقيات</span>
              </CardTitle>
            </CardHeader>
            <CardContent className="pt-6 grid lg:grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label>اسم الشركة</Label>
                <Input
                  placeholder="اسم الشركة"
                  value={company.name}
                  onChange={(event) => setCompany({ ...company, name: event.target.value })}
                />
              </div>
              <div className="space-y-2">
                <Label>رقم السجل التجاري</Label>
                <Input
                  placeholder="CR"
                  value={company.crNumber}
                  onChange={(event) => setCompany({ ...company, crNumber: event.target.value })}
                />
              </div>
            </CardContent>
          </Card>

          <Card className="border-slate-200 dark:border-slate-800 shadow-sm">
            <CardHeader className="border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-900/50">
              <CardTitle className="text-lg flex items-center gap-2">
                <FileText className="w-5 h-5 text-violet-500" />
                <span>بنود الاتفاقية الثابتة</span>
              </CardTitle>
            </CardHeader>
            <CardContent className="pt-6 space-y-4">
              <div className="space-y-2">
                <Label>شروط عقد الإيجار</Label>
                <Textarea
                  placeholder="اكتب شروط عقد الإيجار"
                  value={contracts.rentalTerms}
                  onChange={(event) => setContracts({ ...contracts, rentalTerms: event.target.value })}
                  className="min-h-[120px]"
                />
              </div>
              <div className="space-y-2">
                <Label>بنود عقد الإيجار</Label>
                <Textarea
                  placeholder="اكتب بنود عقد الإيجار"
                  value={contracts.rentalClauses}
                  onChange={(event) => setContracts({ ...contracts, rentalClauses: event.target.value })}
                  className="min-h-[120px]"
                />
              </div>
              <div className="space-y-2">
                <Label>شروط عقد البيع</Label>
                <Textarea
                  placeholder="اكتب شروط عقد البيع"
                  value={contracts.salesTerms}
                  onChange={(event) => setContracts({ ...contracts, salesTerms: event.target.value })}
                  className="min-h-[120px]"
                />
              </div>
              <div className="space-y-2">
                <Label>بنود عقد البيع</Label>
                <Textarea
                  placeholder="اكتب بنود عقد البيع"
                  value={contracts.salesClauses}
                  onChange={(event) => setContracts({ ...contracts, salesClauses: event.target.value })}
                  className="min-h-[120px]"
                />
              </div>
            </CardContent>
          </Card>
        </div>
      </div>
    </DashboardLayout>
  )
}


export default function WebsiteSettings() {
  return (
    <Suspense fallback={<div>Loading...</div>}>
      <WebsiteSettingsContent />
    </Suspense>
  )
}
