    icon: <ShoppingCart className="w-5 h-5" />,
    submenu: [
      { key: 'salesInvoices', href: '/sales' },
      { key: 'rentalInvoices', href: '/invoices' },
      { key: 'customerReceipts', href: '/payments?type=customer' },
      { key: 'salesCreditNotes', href: '/credits' },
      { key: 'customerStatements', href: '/reports/accounts' },
      { key: 'revenueAnalysis', href: '/reports/analysis' },
    ]
  },

  {
    key: 'purchases2',
    icon: <ShoppingBag className="w-5 h-5" />,
    submenu: [
      { key: 'purchasesDashboard', href: '/purchases/dashboard' },
      { key: 'purchaseRequisitions', href: '/purchase-orders/requisitions' },
      { key: 'purchaseOrders', href: '/purchase-orders' },
      { key: 'newSupplierBill', href: '/purchases/new' },
