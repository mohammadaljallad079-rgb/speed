"use client"
import { Suspense, useState, useEffect } from 'react'
export const dynamic = "force-dynamic"
import { supabase } from '@/lib/supabase'
import DashboardLayout from '@/components/DashboardLayout'
import { useLanguage } from '@/lib/LanguageContext'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { Badge } from '@/components/ui/badge'
import { TrendingUp, Download, Calendar, ArrowLeft, TrendingDown, Minus } from 'lucide-react'
import { useRouter } from 'next/navigation'
import * as XLSX from 'xlsx'

interface PLRow {
  account_code: string
  account_name: string
  account_name_ar: string
  amount: number
  type: 'revenue' | 'expense'
}

function ProfitLossContent() {
  const { isRTL } = useLanguage()
  const router = useRouter()
  const [revenues, setRevenues] = useState<PLRow[]>([])
  const [expenses, setExpenses] = useState<PLRow[]>([])
  const [loading, setLoading] = useState(true)
  const [fromDate, setFromDate] = useState(new Date(new Date().getFullYear(), 0, 1).toISOString().split('T')[0])
  const [toDate, setToDate] = useState(new Date().toISOString().split('T')[0])

  useEffect(() => {
    loadData()
  }, [fromDate, toDate])

  async function loadData() {
    setLoading(true)
    try {
      const { data: accounts } = await supabase
        .from('chart_of_accounts')
        .select('*')
        .in('account_type', ['revenue', 'expense'])

      const { data: entries } = await supabase
        .from('journal_entries')
        .select('*')
        .gte('date', fromDate)
        .lte('date', toDate)

      const revRows: PLRow[] = []
      const expRows: PLRow[] = []

      ;(accounts || []).forEach((acc: any) => {
        if (acc.account_type === 'revenue') {
          const accEntries = (entries || []).filter((e: any) => e.account_id === acc.id)
          const credit = accEntries.reduce((s: number, e: any) => s + Number(e.credit || 0), 0)
          const debit = accEntries.reduce((s: number, e: any) => s + Number(e.debit || 0), 0)
          const amount = credit - debit
          if (amount !== 0) {
            revRows.push({
              account_code: acc.account_code || '',
              account_name: acc.account_name || '',
              account_name_ar: acc.account_name_ar || acc.account_name || '',
              amount,
              type: 'revenue'
            })
          }
        } else if (acc.account_type === 'expense') {
          const accEntries = (entries || []).filter((e: any) => e.account_id === acc.id)
          const debit = accEntries.reduce((s: number, e: any) => s + Number(e.debit || 0), 0)
          const credit = accEntries.reduce((s: number, e: any) => s + Number(e.credit || 0), 0)
          const amount = debit - credit
          if (amount !== 0) {
            expRows.push({
              account_code: acc.account_code || '',
              account_name: acc.account_name || '',
              account_name_ar: acc.account_name_ar || acc.account_name || '',
              amount,
              type: 'expense'
            })
          }
        }
      })

      setRevenues(revRows)
      setExpenses(expRows)
    } catch (err) {
      console.error(err)
    } finally {
      setLoading(false)
    }
  }

  const totalRevenue = revenues.reduce((s, r) => s + r.amount, 0)
  const totalExpenses = expenses.reduce((s, r) => s + r.amount, 0)
  const netProfit = totalRevenue - totalExpenses
  const profitMargin = totalRevenue > 0 ? (netProfit / totalRevenue) * 100 : 0

  function exportExcel() {
    const exportData = [
      { Section: 'REVENUES', Account: '', Amount: '' },
      ...revenues.map(r => ({
        Section: '',
        Account: isRTL ? r.account_name_ar : r.account_name,
        Amount: r.amount
      })),
      { Section: '', Account: 'TOTAL REVENUE', Amount: totalRevenue },
      { Section: '', Account: '', Amount: '' },
      { Section: 'EXPENSES', Account: '', Amount: '' },
      ...expenses.map(r => ({
        Section: '',
        Account: isRTL ? r.account_name_ar : r.account_name,
        Amount: r.amount
      })),
      { Section: '', Account: 'TOTAL EXPENSES', Amount: totalExpenses },
      { Section: '', Account: '', Amount: '' },
      { Section: '', Account: 'NET PROFIT', Amount: netProfit }
    ]
    const ws = XLSX.utils.json_to_sheet(exportData)
    const wb = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(wb, ws, 'P&L')
    XLSX.writeFile(wb, `Profit_Loss_${fromDate}_to_${toDate}.xlsx`)
  }

  return (
    <DashboardLayout>
      <div className="min-h-screen bg-[#f0f2f5]" dir={isRTL ? "rtl" : "ltr"}>
        <div className="p-6 max-w-5xl mx-auto space-y-6">
          {/* Header */}
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              <Button variant="outline" size="icon" onClick={() => router.back()} className="rounded-lg">
                <ArrowLeft className={isRTL ? 'rotate-180' : ''} />
              </Button>
              <div>
                <h1 className="text-2xl font-black text-slate-900">
                  {isRTL ? 'قائمة الدخل' : 'Profit & Loss Statement'}
                </h1>
                <p className="text-sm text-slate-500">
                  {isRTL ? 'الإيرادات والمصروفات وصافي الربح' : 'Revenues, expenses and net profit'}
                </p>
              </div>
            </div>
            <Button onClick={exportExcel} className="bg-emerald-600 hover:bg-emerald-700 rounded-xl">
              <Download className="w-4 h-4 mr-2" />
              {isRTL ? 'تصدير Excel' : 'Export Excel'}
            </Button>
          </div>

          {/* Date Filter */}
          <Card className="border-0 shadow-md">
            <CardContent className="p-4">
              <div className="flex flex-col md:flex-row gap-4">
                <div className="flex-1">
                  <Label className="text-xs text-slate-500 mb-1 block">{isRTL ? 'من' : 'From'}</Label>
                  <div className="relative">
                    <Calendar className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
                    <Input type="date" value={fromDate} onChange={e => setFromDate(e.target.value)} className="pl-10 rounded-lg" />
                  </div>
                </div>
                <div className="flex-1">
                  <Label className="text-xs text-slate-500 mb-1 block">{isRTL ? 'إلى' : 'To'}</Label>
                  <div className="relative">
                    <Calendar className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
                    <Input type="date" value={toDate} onChange={e => setToDate(e.target.value)} className="pl-10 rounded-lg" />
                  </div>
                </div>
              </div>
            </CardContent>
          </Card>

          {/* Summary Cards */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <Card className="border-0 shadow-md bg-gradient-to-br from-emerald-50 to-white">
              <CardContent className="p-4">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
                    <TrendingUp className="w-5 h-5 text-emerald-600" />
                  </div>
                  <div>
                    <p className="text-xs text-slate-500">{isRTL ? 'إجمالي الإيرادات' : 'Total Revenue'}</p>
                    <p className="text-xl font-black text-emerald-600">{totalRevenue.toFixed(3)} BHD</p>
                  </div>
                </div>
              </CardContent>
            </Card>
            <Card className="border-0 shadow-md bg-gradient-to-br from-red-50 to-white">
              <CardContent className="p-4">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center">
                    <TrendingDown className="w-5 h-5 text-red-600" />
                  </div>
                  <div>
                    <p className="text-xs text-slate-500">{isRTL ? 'إجمالي المصروفات' : 'Total Expenses'}</p>
                    <p className="text-xl font-black text-red-600">{totalExpenses.toFixed(3)} BHD</p>
                  </div>
                </div>
              </CardContent>
            </Card>
            <Card className={`border-0 shadow-md ${netProfit >= 0 ? 'bg-gradient-to-br from-blue-50 to-white' : 'bg-gradient-to-br from-amber-50 to-white'}`}>
              <CardContent className="p-4">
                <div className="flex items-center gap-3">
                  <div className={`w-10 h-10 rounded-xl flex items-center justify-center ${netProfit >= 0 ? 'bg-blue-100' : 'bg-amber-100'}`}>
                    {netProfit >= 0 ? <TrendingUp className="w-5 h-5 text-blue-600" /> : <Minus className="w-5 h-5 text-amber-600" />}
                  </div>
                  <div>
                    <p className="text-xs text-slate-500">{isRTL ? 'صافي الربح' : 'Net Profit'}</p>
                    <p className={`text-xl font-black ${netProfit >= 0 ? 'text-blue-600' : 'text-amber-600'}`}>{netProfit.toFixed(3)} BHD</p>
                    <Badge className={`mt-1 text-[10px] ${netProfit >= 0 ? 'bg-blue-100 text-blue-700' : 'bg-amber-100 text-amber-700'}`}>
                      {profitMargin.toFixed(1)}% {isRTL ? 'هامش ربح' : 'Margin'}
                    </Badge>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>

          {/* P&L Statement */}
          <Card className="border-0 shadow-md overflow-hidden">
            <CardHeader className="bg-gradient-to-r from-slate-900 to-slate-800 text-white">
              <CardTitle className="flex items-center gap-2 text-base">
                <TrendingUp className="w-5 h-5" />
                {isRTL ? 'تفاصيل قائمة الدخل' : 'Profit & Loss Details'}
              </CardTitle>
            </CardHeader>
            <CardContent className="p-0">
              {loading ? (
                <div className="p-8 text-center text-slate-400">{isRTL ? 'جاري التحميل...' : 'Loading...'}</div>
              ) : (
                <div className="p-6 space-y-6">
                  {/* Revenues Section */}
                  <div>
                    <div className="flex items-center gap-2 mb-3 pb-2 border-b-2 border-emerald-200">
                      <TrendingUp className="w-5 h-5 text-emerald-600" />
                      <h3 className="text-lg font-bold text-emerald-700">{isRTL ? 'الإيرادات' : 'REVENUES'}</h3>
                    </div>
                    {revenues.length === 0 ? (
                      <p className="text-sm text-slate-400 py-2">{isRTL ? 'لا توجد إيرادات' : 'No revenues'}</p>
                    ) : (
                      <div className="space-y-1">
                        {revenues.map((r, i) => (
                          <div key={i} className="flex justify-between items-center py-2 px-3 rounded-lg hover:bg-slate-50">
                            <div>
                              <p className="text-sm font-semibold text-slate-800">{isRTL ? r.account_name_ar : r.account_name}</p>
                              <p className="text-xs text-slate-400 font-mono">{r.account_code}</p>
                            </div>
                            <p className="text-sm font-bold text-emerald-600 font-mono">{r.amount.toFixed(3)} BHD</p>
                          </div>
                        ))}
                        <div className="flex justify-between items-center py-3 px-3 bg-emerald-50 rounded-xl mt-2">
                          <p className="text-sm font-bold text-emerald-800">{isRTL ? 'إجمالي الإيرادات' : 'Total Revenue'}</p>
                          <p className="text-lg font-black text-emerald-700 font-mono">{totalRevenue.toFixed(3)} BHD</p>
                        </div>
                      </div>
                    )}
                  </div>

                  {/* Expenses Section */}
                  <div>
                    <div className="flex items-center gap-2 mb-3 pb-2 border-b-2 border-red-200">
                      <TrendingDown className="w-5 h-5 text-red-600" />
                      <h3 className="text-lg font-bold text-red-700">{isRTL ? 'المصروفات' : 'EXPENSES'}</h3>
                    </div>
                    {expenses.length === 0 ? (
                      <p className="text-sm text-slate-400 py-2">{isRTL ? 'لا توجد مصروفات' : 'No expenses'}</p>
                    ) : (
                      <div className="space-y-1">
                        {expenses.map((r, i) => (
                          <div key={i} className="flex justify-between items-center py-2 px-3 rounded-lg hover:bg-slate-50">
                            <div>
                              <p className="text-sm font-semibold text-slate-800">{isRTL ? r.account_name_ar : r.account_name}</p>
                              <p className="text-xs text-slate-400 font-mono">{r.account_code}</p>
                            </div>
                            <p className="text-sm font-bold text-red-600 font-mono">{r.amount.toFixed(3)} BHD</p>
                          </div>
                        ))}
                        <div className="flex justify-between items-center py-3 px-3 bg-red-50 rounded-xl mt-2">
                          <p className="text-sm font-bold text-red-800">{isRTL ? 'إجمالي المصروفات' : 'Total Expenses'}</p>
                          <p className="text-lg font-black text-red-700 font-mono">{totalExpenses.toFixed(3)} BHD</p>
                        </div>
                      </div>
                    )}
                  </div>

                  {/* Net Profit */}
                  <div className={`p-4 rounded-2xl ${netProfit >= 0 ? 'bg-gradient-to-r from-blue-50 to-emerald-50 border border-blue-200' : 'bg-gradient-to-r from-amber-50 to-red-50 border border-amber-200'}`}>
                    <div className="flex justify-between items-center">
                      <div>
                        <p className="text-sm font-bold text-slate-700">{isRTL ? 'صافي الربح / الخسارة' : 'Net Profit / Loss'}</p>
                        <p className="text-xs text-slate-500">{isRTL ? 'الإيرادات - المصروفات' : 'Revenue - Expenses'}</p>
                      </div>
                      <p className={`text-2xl font-black font-mono ${netProfit >= 0 ? 'text-emerald-600' : 'text-red-600'}`}>
                        {netProfit >= 0 ? '+' : ''}{netProfit.toFixed(3)} BHD
                      </p>
                    </div>
                  </div>
                </div>
              )}
            </CardContent>
          </Card>
        </div>
      </div>
    </DashboardLayout>
  )
}

export default function ProfitLossPage() {
  return (
    <Suspense fallback={<div className="min-h-screen bg-[#f0f2f5] flex items-center justify-center"><div className="w-10 h-10 bg-slate-800 rounded-xl animate-pulse" /></div>}>
      <ProfitLossContent />
    </Suspense>
  )
}
