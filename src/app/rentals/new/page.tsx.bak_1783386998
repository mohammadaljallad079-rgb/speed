"use client"
export const dynamic = "force-dynamic"

import { Suspense } from "react"
import { useEffect, useState, useRef } from "react"
import { useRouter } from "next/navigation"
import { jsPDF } from "jspdf"
import DashboardLayout from "@/components/DashboardLayout"
import { supabase } from "@/lib/supabase"
import { Button } from "@/components/ui/button"
import { Input } from "@/components/ui/input"
import { Label } from "@/components/ui/label"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { useLanguage } from "@/lib/LanguageContext"
import { ArrowLeft, Plus, Trash2, Upload, X, Car, User, FileText, MapPin, DollarSign, Wrench, Image as ImageIcon } from "lucide-react"
import Link from "next/link"

interface Customer {
  id: string
  full_name: string | null
  email: string | null
  phone: string | null
  national_id: string | null
  license_number: string | null
}

interface Car {
  id: string
  make: string | null
  model: string | null
  year: number | null
  plate_number: string | null
  daily_rate: number | null
  mileage: number | null
}

interface ScratchPhoto {
  file: File
  preview: string
  description: string
  location: string
}

function NewRentalForm() {
  const router = useRouter()
  const { isRTL } = useLanguage()
  const scratchInputRef = useRef<HTMLInputElement>(null)

  const [cars, setCars] = useState<Car[]>([])
  const [customers, setCustomers] = useState<Customer[]>([])
  const [loading, setLoading] = useState(false)
  const [selectedCar, setSelectedCar] = useState<Car | null>(null)
  const [selectedCustomer, setSelectedCustomer] = useState<Customer | null>(null)
  const [scratchPhotos, setScratchPhotos] = useState<ScratchPhoto[]>([])
  const [plateSearch, setPlateSearch] = useState('')
  const [plateNotFound, setPlateNotFound] = useState(false)
  const [companySettings, setCompanySettings] = useState({ name: "", phone: "", email: "", address: "", crNumber: "" })

  const [contract, setContract] = useState({
    contract_number: "RC-" + Date.now().toString().slice(-6),
    contract_type: "rental",
    customer_id: "",
    car_id: "",
    start_date: "",
    end_date: "",
    daily_rate: "",
    deposit_amount: "",
    total_amount: "",
    paid_amount: "",
    pickup_location: "",
    dropoff_location: "",
    pickup_mileage: "",
    dropoff_mileage: "",
    allowed_km_per_day: "",
    extra_km_charge: "",
    foc_days: "0",
    terms: "",
    clauses: "",
  })

  const totalDays = (() => {
    if (!contract.start_date || !contract.end_date) return 0
    const diff = new Date(contract.end_date).getTime() - new Date(contract.start_date).getTime()
    return Math.max(1, Math.floor(diff / 86400000) + 1)
  })()

  const billableDays = Math.max(0, totalDays - parseInt(contract.foc_days || "0"))
  const dailyRate = parseFloat(contract.daily_rate || "0")
  const autoTotal = (dailyRate * billableDays).toFixed(3)

  useEffect(() => {
    const fetchData = async () => {
      const [carsRes, customersRes, settingsRes] = await Promise.all([
        supabase.from("cars").select("id,make,model,year,plate_number,daily_rate,mileage").order("make"),
        supabase.from("customers").select("id,full_name,email,phone,national_id,license_number").order("full_name"),
        supabase.from("settings").select("company_profile").single(),
      ])
      setCars(carsRes.data || [])
      setCustomers(customersRes.data || [])
      if (settingsRes.data?.company_profile) {
        const p = settingsRes.data.company_profile
        setCompanySettings({ name: p.name || "", phone: p.phone || "", email: p.email || "", address: p.address || "", crNumber: p.crNumber || "" })
      }
    }
    fetchData()
  }, [])

  const handlePlateSearch = (plate: string) => {
    setPlateSearch(plate)
    setPlateNotFound(false)
    const found = cars.find(c => c.plate_number?.toLowerCase() === plate.toLowerCase().trim())
    if (found) {
      handleCarChange(found.id)
      setPlateNotFound(false)
    } else if (plate.length >= 3) {
      setPlateNotFound(true)
      setSelectedCar(null)
      setContract(prev => ({ ...prev, car_id: '' }))
    }
  }

  const handleCarChange = (carId: string) => {
    const car = cars.find(c => c.id === carId) || null
    setSelectedCar(car)
    setContract(prev => ({
      ...prev,
      car_id: carId,
      daily_rate: car?.daily_rate?.toString() || "",
      pickup_mileage: car?.mileage?.toString() || "",
    }))
  }

  const handleCustomerChange = (customerId: string) => {
    const customer = customers.find(c => c.id === customerId) || null
    setSelectedCustomer(customer)
    setContract(prev => ({ ...prev, customer_id: customerId }))
  }

  const handleScratchPhoto = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = Array.from(e.target.files || [])
    const newPhotos: ScratchPhoto[] = files.map(file => ({
      file,
      preview: URL.createObjectURL(file),
      description: "",
      location: "",
    }))
    setScratchPhotos(prev => [...prev, ...newPhotos])
    if (scratchInputRef.current) scratchInputRef.current.value = ""
  }

  const removeScratchPhoto = (index: number) => {
    setScratchPhotos(prev => prev.filter((_, i) => i !== index))
  }

  const updateScratchPhoto = (index: number, field: "description" | "location", value: string) => {
    setScratchPhotos(prev => prev.map((p, i) => i === index ? { ...p, [field]: value } : p))
  }

  const handleSubmit = async (event: React.FormEvent) => {
    event.preventDefault()
    setLoading(true)
    try {
      const customer = customers.find(c => c.id === contract.customer_id)
      const car = cars.find(c => c.id === contract.car_id)
      if (!customer || !car) {
        alert(isRTL ? "يرجى اختيار العميل والسيارة" : "Please select customer and car")
        setLoading(false)
        return
      }

      const startDate = contract.start_date ? new Date(contract.start_date) : null
      const endDate = contract.end_date ? new Date(contract.end_date) : null
      const dayMs = 86400000
      const rawDays = startDate && endDate ? Math.floor((endDate.getTime() - startDate.getTime()) / dayMs) + 1 : 1
      const totalDaysCalc = Math.max(1, rawDays)
      const focDays = parseInt(contract.foc_days || "0")
      const billable = Math.max(0, totalDaysCalc - focDays)
      const dailyRateNum = parseFloat(contract.daily_rate || "0") || 0
      const depositNum = parseFloat(contract.deposit_amount || "0") || 0
      const paidNum = parseFloat(contract.paid_amount || "0") || 0
      const subtotal = dailyRateNum * billable
      const totalAmount = parseFloat(contract.total_amount || "") || subtotal

      // Upload scratch photos
      const scratchData: any[] = []
      for (const photo of scratchPhotos) {
        const ext = photo.file.name.split(".").pop()
        const path = `scratches/${Date.now()}_${Math.random().toString(36).slice(2)}.${ext}`
        const { error: uploadErr } = await supabase.storage.from("documents").upload(path, photo.file, { upsert: true })
        if (!uploadErr) {
          const { data: urlData } = supabase.storage.from("documents").getPublicUrl(path)
          scratchData.push({ url: urlData.publicUrl, description: photo.description, location: photo.location })
        }
      }

      // Generate PDF
      const pdf = new jsPDF()
      pdf.setFont("helvetica", "bold")
      pdf.setFontSize(18)
      pdf.text("RENTAL CONTRACT", 105, 20, { align: "center" })
      pdf.setFontSize(10)
      pdf.setFont("helvetica", "normal")
      pdf.text(companySettings.name, 105, 28, { align: "center" })
      pdf.text(`Tel: ${companySettings.phone} | CR: ${companySettings.crNumber}`, 105, 34, { align: "center" })
      pdf.line(20, 38, 190, 38)
      let y = 45
      pdf.setFont("helvetica", "bold")
      pdf.text(`Contract #: ${contract.contract_number}`, 20, y)
      pdf.text(`Type: ${contract.contract_type}`, 120, y); y += 10
      pdf.text("CUSTOMER DETAILS", 20, y); y += 7
      pdf.setFont("helvetica", "normal")
      pdf.text(`Name: ${customer.full_name || ""}`, 20, y)
      pdf.text(`ID: ${customer.national_id || ""}`, 120, y); y += 7
      pdf.text(`Phone: ${customer.phone || ""}`, 20, y)
      pdf.text(`License: ${customer.license_number || ""}`, 120, y); y += 10
      pdf.setFont("helvetica", "bold")
      pdf.text("VEHICLE DETAILS", 20, y); y += 7
      pdf.setFont("helvetica", "normal")
      pdf.text(`Car: ${car.make} ${car.model} ${car.year}`, 20, y)
      pdf.text(`Plate: ${car.plate_number || ""}`, 120, y); y += 7
      pdf.text(`Start: ${contract.start_date}`, 20, y)
      pdf.text(`End: ${contract.end_date}`, 120, y); y += 7
      pdf.text(`Pickup KM: ${contract.pickup_mileage || "—"}`, 20, y)
      pdf.text(`Dropoff KM: ${contract.dropoff_mileage || "—"}`, 120, y); y += 7
      pdf.text(`Allowed KM/Day: ${contract.allowed_km_per_day || "—"}`, 20, y)
      pdf.text(`Extra KM Charge: ${contract.extra_km_charge || "—"}`, 120, y); y += 10
      pdf.setFont("helvetica", "bold")
      pdf.text("PRICING", 20, y); y += 7
      pdf.setFont("helvetica", "normal")
      pdf.text(`Total Days: ${totalDaysCalc}`, 20, y)
      pdf.text(`FOC Days: ${focDays}`, 120, y); y += 7
      pdf.text(`Billable Days: ${billable}`, 20, y)
      pdf.text(`Daily Rate: ${dailyRateNum.toFixed(3)} BHD`, 120, y); y += 7
      pdf.text(`Subtotal: ${subtotal.toFixed(3)} BHD`, 20, y)
      pdf.text(`Deposit: ${depositNum.toFixed(3)} BHD`, 120, y); y += 7
      pdf.text(`Total: ${totalAmount.toFixed(3)} BHD`, 20, y)
      pdf.text(`Paid: ${paidNum.toFixed(3)} BHD`, 120, y); y += 10
      pdf.text(`Pickup: ${contract.pickup_location}`, 20, y); y += 7
      pdf.text(`Dropoff: ${contract.dropoff_location}`, 20, y); y += 10
      if (contract.terms) { pdf.setFont("helvetica", "bold"); pdf.text("Terms:", 20, y); y += 7; pdf.setFont("helvetica", "normal"); const lines = pdf.splitTextToSize(contract.terms, 170); pdf.text(lines, 20, y); y += lines.length * 7 }
      pdf.line(20, y + 10, 80, y + 10)
      pdf.line(120, y + 10, 190, y + 10)
      pdf.text("Customer Signature", 35, y + 16)
      pdf.text("Company Signature", 135, y + 16)

      const pdfBlob = new Blob([pdf.output("arraybuffer")], { type: "application/pdf" })
      const { data: uploadData, error: uploadError } = await supabase.storage.from("contracts").upload(`contract-${Date.now()}.pdf`, pdfBlob, { contentType: "application/pdf" })
      if (uploadError) throw uploadError
      const { data: pdfUrlData } = supabase.storage.from("contracts").getPublicUrl(uploadData.path)

      const { error } = await supabase.from("rental_contracts").insert({
        contract_number: contract.contract_number,
        contract_type: contract.contract_type,
        customer_id: contract.customer_id,
        car_id: contract.car_id,
        start_date: contract.start_date,
        end_date: contract.end_date,
        daily_rate: dailyRateNum,
        deposit_amount: depositNum,
        total_days: totalDaysCalc,
        foc_days: focDays,
        billable_days: billable,
        subtotal,
        vat_rate: 0,
        vat_amount: 0,
        discount: 0,
        total_amount: totalAmount,
        paid_amount: paidNum,
        pickup_location: contract.pickup_location,
        dropoff_location: contract.dropoff_location,
        pickup_mileage: contract.pickup_mileage ? parseInt(contract.pickup_mileage) : null,
        dropoff_mileage: contract.dropoff_mileage ? parseInt(contract.dropoff_mileage) : null,
        allowed_km_per_day: contract.allowed_km_per_day ? parseInt(contract.allowed_km_per_day) : null,
        extra_km_charge: contract.extra_km_charge ? parseFloat(contract.extra_km_charge) : null,
        terms: contract.terms,
        clauses: contract.clauses,
        scratch_photos: scratchData.length > 0 ? JSON.stringify(scratchData) : null,
        contract_pdf_url: pdfUrlData?.publicUrl || null,
        status: "active",
      })
      if (error) throw error
      router.push("/rentals")
    } catch (error) {
      console.error("Failed to create contract:", error)
      alert(isRTL ? "فشل إنشاء العقد. يرجى التحقق من الحقول المطلوبة." : "Failed to create contract. Please check required fields.")
    } finally {
      setLoading(false)
    }
  }

  return (
    <DashboardLayout>
      <div className="max-w-5xl mx-auto space-y-6">
        <header className="flex items-center gap-4">
          <Button variant="outline" size="icon" onClick={() => router.back()}>
            <ArrowLeft className={isRTL ? "rotate-180" : ""} />
          </Button>
          <div>
            <h1 className="text-3xl font-bold text-slate-900 dark:text-white">
              {isRTL ? "عقد تأجير جديد" : "New Rental Contract"}
            </h1>
            <p className="text-slate-500">{isRTL ? "أضف عقد تأجير أو مبيعات جديد" : "Add a new rental or sales contract"}</p>
          </div>
        </header>

        <form onSubmit={handleSubmit} className="space-y-6">

          {/* Section 1: Contract Info */}
          <Card className="rounded-2xl shadow-sm border-slate-200 dark:border-slate-700 overflow-hidden">
            <CardHeader className="bg-slate-900 text-white py-4 px-6">
              <CardTitle className="flex items-center gap-2 text-base">
                <FileText className="w-5 h-5" />
                {isRTL ? "معلومات العقد" : "Contract Information"}
              </CardTitle>
            </CardHeader>
            <CardContent className="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label>{isRTL ? "رقم العقد" : "Contract Number"}</Label>
                <Input value={contract.contract_number} onChange={e => setContract({...contract, contract_number: e.target.value})} required />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "نوع العقد" : "Contract Type"}</Label>
                <select className="h-10 w-full rounded-md border border-input bg-background px-3 text-sm" value={contract.contract_type} onChange={e => setContract({...contract, contract_type: e.target.value})}>
                  <option value="rental">{isRTL ? "تأجير" : "Rental"}</option>
                  <option value="sales">{isRTL ? "مبيعات" : "Sales"}</option>
                </select>
              </div>
            </CardContent>
          </Card>

          {/* Section 2: Customer */}
          <Card className="rounded-2xl shadow-sm border-slate-200 dark:border-slate-700 overflow-hidden">
            <CardHeader className="bg-violet-700 text-white py-4 px-6">
              <CardTitle className="flex items-center gap-2 text-base">
                <User className="w-5 h-5" />
                {isRTL ? "بيانات العميل" : "Customer Details"}
              </CardTitle>
            </CardHeader>
            <CardContent className="p-6 space-y-4">
              <div className="space-y-2">
                <Label>{isRTL ? "اختر العميل" : "Select Customer"}</Label>
                <select className="h-10 w-full rounded-md border border-input bg-background px-3 text-sm" value={contract.customer_id} onChange={e => handleCustomerChange(e.target.value)} required>
                  <option value="">{isRTL ? "اختر من القائمة..." : "Select a customer..."}</option>
                  {customers.map(c => (
                    <option key={c.id} value={c.id}>{c.full_name} — {c.phone}</option>
                  ))}
                </select>
              </div>
              {selectedCustomer && (
                <div className="grid grid-cols-2 md:grid-cols-3 gap-3 p-4 bg-violet-50 dark:bg-violet-900/10 rounded-xl text-sm">
                  <div><span className="text-slate-500">{isRTL ? "الهاتف:" : "Phone:"}</span> <span className="font-medium">{selectedCustomer.phone}</span></div>
                  <div><span className="text-slate-500">{isRTL ? "الهوية:" : "ID:"}</span> <span className="font-medium">{selectedCustomer.national_id || "—"}</span></div>
                  <div><span className="text-slate-500">{isRTL ? "الرخصة:" : "License:"}</span> <span className="font-medium">{selectedCustomer.license_number || "—"}</span></div>
                </div>
              )}
            </CardContent>
          </Card>

          {/* Section 3: Car */}
          <Card className="rounded-2xl shadow-sm border-slate-200 dark:border-slate-700 overflow-hidden">
            <CardHeader className="bg-cyan-700 text-white py-4 px-6">
              <CardTitle className="flex items-center gap-2 text-base">
                <Car className="w-5 h-5" />
                {isRTL ? "بيانات السيارة" : "Vehicle Details"}
              </CardTitle>
            </CardHeader>
            <CardContent className="p-6 space-y-4">
              <div className="space-y-2">
                <Label>{isRTL ? "بحث برقم اللوحة" : "Search by Plate Number"}</Label>
                <div className="relative">
                  <Input
                    placeholder={isRTL ? "أدخل رقم اللوحة..." : "Enter plate number..."}
                    value={plateSearch}
                    onChange={e => handlePlateSearch(e.target.value)}
                    className="pr-10"
                    dir="ltr"
                  />
                  {selectedCar && <span className="absolute left-3 top-1/2 -translate-y-1/2 text-emerald-500 text-xs font-bold">✓</span>}
                </div>
                {plateNotFound && <p className="text-xs text-red-500">{isRTL ? "لم يتم العثور على سيارة بهذا الرقم" : "No car found with this plate number"}</p>}
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "أو اختر السيارة" : "Or Select Car"}</Label>
                <select className="h-10 w-full rounded-md border border-input bg-background px-3 text-sm" value={contract.car_id} onChange={e => { handleCarChange(e.target.value); const c = cars.find(x => x.id === e.target.value); if (c) setPlateSearch(c.plate_number || '') }} required>
                  <option value="">{isRTL ? "اختر من القائمة..." : "Select a car..."}</option>
                  {cars.map(c => (
                    <option key={c.id} value={c.id}>{c.make} {c.model} {c.year} — {c.plate_number}</option>
                  ))}
                </select>
              </div>
              {selectedCar && (
                <div className="p-4 bg-cyan-50 dark:bg-cyan-900/10 rounded-xl text-sm">
                  <span className="text-slate-500">{isRTL ? "السعر اليومي:" : "Daily Rate:"}</span> <span className="font-bold text-cyan-700">{selectedCar.daily_rate} {isRTL ? "د.ب" : "BHD"}</span>
                  <span className="mr-4 ml-4 text-slate-500">{isRTL ? "الممشى:" : "Mileage:"}</span> <span className="font-medium">{selectedCar.mileage} {isRTL ? "كم" : "km"}</span>
                </div>
              )}
            </CardContent>
          </Card>

          {/* Section 4: Dates & KM */}
          <Card className="rounded-2xl shadow-sm border-slate-200 dark:border-slate-700 overflow-hidden">
            <CardHeader className="bg-emerald-700 text-white py-4 px-6">
              <CardTitle className="flex items-center gap-2 text-base">
                <Wrench className="w-5 h-5" />
                {isRTL ? "التواريخ والكيلومترات" : "Dates & Mileage"}
              </CardTitle>
            </CardHeader>
            <CardContent className="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label>{isRTL ? "تاريخ البداية" : "Start Date"}</Label>
                <Input type="date" value={contract.start_date} onChange={e => setContract({...contract, start_date: e.target.value})} required />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "تاريخ النهاية" : "End Date"}</Label>
                <Input type="date" value={contract.end_date} onChange={e => setContract({...contract, end_date: e.target.value})} required />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "كيلومترات الاستلام" : "Pickup Mileage (km)"}</Label>
                <Input type="number" value={contract.pickup_mileage} onChange={e => setContract({...contract, pickup_mileage: e.target.value})} placeholder="0" />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "كيلومترات التسليم" : "Dropoff Mileage (km)"}</Label>
                <Input type="number" value={contract.dropoff_mileage} onChange={e => setContract({...contract, dropoff_mileage: e.target.value})} placeholder="0" />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "الكيلومترات المسموحة يومياً" : "Allowed KM/Day"}</Label>
                <Input type="number" value={contract.allowed_km_per_day} onChange={e => setContract({...contract, allowed_km_per_day: e.target.value})} placeholder="200" />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "رسوم الكيلومتر الإضافي (د.ب)" : "Extra KM Charge (BHD)"}</Label>
                <Input type="number" step="0.001" value={contract.extra_km_charge} onChange={e => setContract({...contract, extra_km_charge: e.target.value})} placeholder="0.100" />
              </div>
              {totalDays > 0 && (
                <div className="md:col-span-2 p-3 bg-emerald-50 dark:bg-emerald-900/10 rounded-xl text-sm flex gap-6">
                  <span>{isRTL ? "إجمالي الأيام:" : "Total Days:"} <strong>{totalDays}</strong></span>
                  <span>{isRTL ? "أيام FOC:" : "FOC Days:"} <strong>{contract.foc_days}</strong></span>
                  <span>{isRTL ? "أيام قابلة للفوترة:" : "Billable Days:"} <strong>{billableDays}</strong></span>
                </div>
              )}
            </CardContent>
          </Card>

          {/* Section 5: Pricing */}
          <Card className="rounded-2xl shadow-sm border-slate-200 dark:border-slate-700 overflow-hidden">
            <CardHeader className="bg-amber-700 text-white py-4 px-6">
              <CardTitle className="flex items-center gap-2 text-base">
                <DollarSign className="w-5 h-5" />
                {isRTL ? "التسعير والمدفوعات" : "Pricing & Payments"}
              </CardTitle>
            </CardHeader>
            <CardContent className="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label>{isRTL ? "أيام مجانية (FOC)" : "Free of Charge Days (FOC)"}</Label>
                <Input type="number" min="0" value={contract.foc_days} onChange={e => setContract({...contract, foc_days: e.target.value})} placeholder="0" />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "السعر اليومي (د.ب)" : "Daily Rate (BHD)"}</Label>
                <Input type="number" step="0.001" value={contract.daily_rate} onChange={e => setContract({...contract, daily_rate: e.target.value})} required />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "الإجمالي التلقائي (د.ب)" : "Auto Total (BHD)"}</Label>
                <Input value={autoTotal} readOnly className="bg-slate-50 dark:bg-slate-700 font-bold text-emerald-600" />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "الإجمالي الفعلي (د.ب)" : "Final Total (BHD)"}</Label>
                <Input type="number" step="0.001" value={contract.total_amount} onChange={e => setContract({...contract, total_amount: e.target.value})} placeholder={autoTotal} />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "مبلغ التأمين (د.ب)" : "Deposit (BHD)"}</Label>
                <Input type="number" step="0.001" value={contract.deposit_amount} onChange={e => setContract({...contract, deposit_amount: e.target.value})} />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "المبلغ المدفوع (د.ب)" : "Paid Amount (BHD)"}</Label>
                <Input type="number" step="0.001" value={contract.paid_amount} onChange={e => setContract({...contract, paid_amount: e.target.value})} />
              </div>
            </CardContent>
          </Card>

          {/* Section 6: Locations */}
          <Card className="rounded-2xl shadow-sm border-slate-200 dark:border-slate-700 overflow-hidden">
            <CardHeader className="bg-blue-700 text-white py-4 px-6">
              <CardTitle className="flex items-center gap-2 text-base">
                <MapPin className="w-5 h-5" />
                {isRTL ? "مواقع الاستلام والتسليم" : "Pickup & Dropoff Locations"}
              </CardTitle>
            </CardHeader>
            <CardContent className="p-6 grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="space-y-2">
                <Label>{isRTL ? "موقع الاستلام" : "Pickup Location"}</Label>
                <Input value={contract.pickup_location} onChange={e => setContract({...contract, pickup_location: e.target.value})} required />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "موقع التسليم" : "Dropoff Location"}</Label>
                <Input value={contract.dropoff_location} onChange={e => setContract({...contract, dropoff_location: e.target.value})} required />
              </div>
            </CardContent>
          </Card>

          {/* Section 7: Scratch Photos */}
          <Card className="rounded-2xl shadow-sm border-slate-200 dark:border-slate-700 overflow-hidden">
            <CardHeader className="bg-rose-700 text-white py-4 px-6">
              <CardTitle className="flex items-center gap-2 text-base">
                <ImageIcon className="w-5 h-5" />
                {isRTL ? "تسجيل الخدوش والأضرار" : "Scratch & Damage Recording"}
              </CardTitle>
            </CardHeader>
            <CardContent className="p-6 space-y-4">
              <div className="flex items-center gap-3">
                <input ref={scratchInputRef} type="file" accept="image/*" multiple className="hidden" onChange={handleScratchPhoto} />
                <Button type="button" variant="outline" onClick={() => scratchInputRef.current?.click()} className="flex items-center gap-2">
                  <Upload className="w-4 h-4" />
                  {isRTL ? "رفع صور الخدوش" : "Upload Scratch Photos"}
                </Button>
                <span className="text-sm text-slate-500">{scratchPhotos.length} {isRTL ? "صورة" : "photo(s)"}</span>
              </div>

              {scratchPhotos.length > 0 && (
                <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {scratchPhotos.map((photo, index) => (
                    <div key={index} className="border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden">
                      <div className="relative">
                        <img src={photo.preview} alt={`scratch-${index}`} className="w-full h-48 object-cover" />
                        <button
                          type="button"
                          onClick={() => removeScratchPhoto(index)}
                          className="absolute top-2 right-2 w-7 h-7 bg-red-500 hover:bg-red-600 text-white rounded-full flex items-center justify-center shadow-lg"
                        >
                          <X className="w-4 h-4" />
                        </button>
                      </div>
                      <div className="p-3 space-y-2">
                        <Input
                          placeholder={isRTL ? "موقع الخدش (مثال: الباب الأمامي)" : "Location (e.g. Front door)"}
                          value={photo.location}
                          onChange={e => updateScratchPhoto(index, "location", e.target.value)}
                          className="text-sm"
                        />
                        <Input
                          placeholder={isRTL ? "وصف الخدش" : "Description"}
                          value={photo.description}
                          onChange={e => updateScratchPhoto(index, "description", e.target.value)}
                          className="text-sm"
                        />
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </CardContent>
          </Card>

          {/* Section 8: Terms */}
          <Card className="rounded-2xl shadow-sm border-slate-200 dark:border-slate-700">
            <CardContent className="p-6 space-y-4">
              <div className="space-y-2">
                <Label>{isRTL ? "الشروط والأحكام" : "Terms & Conditions"}</Label>
                <textarea className="min-h-[100px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm" value={contract.terms} onChange={e => setContract({...contract, terms: e.target.value})} />
              </div>
              <div className="space-y-2">
                <Label>{isRTL ? "بنود إضافية" : "Additional Clauses"}</Label>
                <textarea className="min-h-[100px] w-full rounded-md border border-input bg-background px-3 py-2 text-sm" value={contract.clauses} onChange={e => setContract({...contract, clauses: e.target.value})} />
              </div>
            </CardContent>
          </Card>

          <Button type="submit" disabled={loading} className="w-full h-14 text-lg rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 text-white shadow-lg">
            {loading ? (isRTL ? "جاري الحفظ..." : "Saving...") : (isRTL ? "حفظ العقد وتوليد PDF" : "Save Contract & Generate PDF")}
          </Button>

        </form>
      </div>
    </DashboardLayout>
  )
}

export default function NewRentalPage() {
  return (
    <Suspense fallback={<div>Loading...</div>}>
      <NewRentalForm />
    </Suspense>
  )
}
