"use client"
import { Suspense, useState, useEffect } from 'react'
export const dynamic = "force-dynamic"
import { supabase } from '@/lib/supabase'
import DashboardLayout from '@/components/DashboardLayout'
import { useLanguage } from '@/lib/LanguageContext'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { Badge } from '@/components/ui/badge'
import { Dialog, DialogContent, DialogHeader, DialogTitle } from '@/components/ui/dialog'
import { TrendingUp, Download, Calendar, ArrowLeft, TrendingDown, Minus, Printer, Eye, X, FileText } from 'lucide-react'
import { useRouter } from 'next/navigation'
import * as XLSX from 'xlsx'

interface PLRow {
  code: string
  name: string
  name_ar: string
  amount: number
  section: 'revenue' | 'cos' | 'opex' | 'admin' | 'other'
  account_id: string
}

interface JournalLine {
  id: string
  journal_entry_id: string
  debit: number
  credit: number
  description: string
  journal_entries: {
    journal_number: string
    entry_date: string
    description: string
  }
}

function ProfitLossContent() {
  const { isRTL } = useLanguage()
  const router = useRouter()
  const [revenues, setRevenues] = useState<PLRow[]>([])
  const [cos, setCos] = useState<PLRow[]>([])
  const [opex, setOpex] = useState<PLRow[]>([])
  const [admin, setAdmin] = useState<PLRow[]>([])
  const [other, setOther] = useState<PLRow[]>([])
  const [loading, setLoading] = useState(true)
  const [fromDate, setFromDate] = useState('2026-01-01')
  const [toDate, setToDate] = useState('2026-12-31')
  const [selectedAccountName, setSelectedAccountName] = useState('')
  const [selectedAccountCode, setSelectedAccountCode] = useState('')
  const [journalLines, setJournalLines] = useState<JournalLine[]>([])
  const [dialogOpen, setDialogOpen] = useState(false)
  const [dialogLoading, setDialogLoading] = useState(false)

  useEffect(() => { loadData() }, [fromDate, toDate])

  function getSection(code: string): 'revenue' | 'cos' | 'opex' | 'admin' | 'other' {
    const num = parseInt(code)
    if (num >= 41000 && num < 51000) return 'revenue'
    if (num >= 51000 && num < 61000) return 'cos'
    if (num >= 61000 && num < 62000) return 'opex'
    if (num >= 62000 && num < 63000) return 'admin'
    return 'other'
  }

  async function loadData() {
    setLoading(true)
    try {
      const { data: accounts } = await supabase
        .from('accounts').select('*').in('type', ['revenue', 'expense']).eq('is_active', true).order('code')

      const { data: journalEntries } = await supabase
        .from('journal_entries').select('id,entry_date').gte('entry_date', fromDate).lte('entry_date', toDate)

      const entryIds = (journalEntries || []).map((e: any) => e.id)

      let lines: any[] = []
      if (entryIds.length > 0) {
        const result = await supabase.from('journal_lines').select('*').in('journal_entry_id', entryIds)
        lines = result.data || []
      }

      const revRows: PLRow[] = []
      const cosRows: PLRow[] = []
      const opexRows: PLRow[] = []
      const adminRows: PLRow[] = []
      const otherRows: PLRow[] = []

      ;(accounts || []).forEach((acc: any) => {
        const accLines = lines.filter((l: any) => l.account_id === acc.id)
        let amount = 0
        if (acc.type === 'revenue') {
          const credit = accLines.reduce((s: number, e: any) => s + Number(e.credit || 0), 0)
          const debit = accLines.reduce((s: number, e: any) => s + Number(e.debit || 0), 0)
          amount = credit - debit
        } else if (acc.type === 'expense') {
          const debit = accLines.reduce((s: number, e: any) => s + Number(e.debit || 0), 0)
          const credit = accLines.reduce((s: number, e: any) => s + Number(e.credit || 0), 0)
          amount = debit - credit
        }

        const row = {
          code: acc.code || '',
          name: acc.name_en || acc.name || '',
          name_ar: acc.name_ar || acc.name || '',
          amount,
          section: getSection(acc.code || '0'),
          account_id: acc.id
        }
        if (row.section === 'revenue') revRows.push(row)
        else if (row.section === 'cos') cosRows.push(row)
        else if (row.section === 'opex') opexRows.push(row)
        else if (row.section === 'admin') adminRows.push(row)
        else otherRows.push(row)
      })

      setRevenues(revRows)
      setCos(cosRows)
      setOpex(opexRows)
      setAdmin(adminRows)
      setOther(otherRows)
    } catch (err) { console.error(err) } finally { setLoading(false) }
  }

  async function showJournalEntries(accountId: string, accountName: string, accountCode: string) {
    setSelectedAccountName(accountName)
    setSelectedAccountCode(accountCode)
    setDialogOpen(true)
    setDialogLoading(true)
    try {
      const { data: journalEntries } = await supabase
        .from('journal_entries').select('id,entry_date').gte('entry_date', fromDate).lte('entry_date', toDate)

      const entryIds = (journalEntries || []).map((e: any) => e.id)
      
      if (entryIds.length === 0) {
        setJournalLines([])
        setDialogLoading(false)
        return
      }

      const { data: lines } = await supabase
        .from('journal_lines')
        .select('id,journal_entry_id,debit,credit,description,journal_entries(journal_number,entry_date,description)')
        .in('journal_entry_id', entryIds)
        .eq('account_id', accountId)

      setJournalLines(lines || [])
    } catch (err) {
      console.error(err)
      setJournalLines([])
    } finally {
      setDialogLoading(false)
    }
  }

  function handlePrint() {
    window.print()
  }

  const totalRevenue = revenues.reduce((s, r) => s + r.amount, 0)
  const totalCos = cos.reduce((s, r) => s + r.amount, 0)
  const totalOpex = opex.reduce((s, r) => s + r.amount, 0)
  const totalAdmin = admin.reduce((s, r) => s + r.amount, 0)
  const totalOther = other.reduce((s, r) => s + r.amount, 0)
  const grossProfit = totalRevenue - totalCos
  const netProfit = grossProfit - totalOpex - totalAdmin - totalOther
  const profitMargin = totalRevenue > 0 ? (netProfit / totalRevenue) * 100 : 0

  function exportExcel() {
    const wb = XLSX.utils.book_new()

    // ====== STYLES ======
    const titleStyle = { 
      font: { bold: true, sz: 22, color: { rgb: 'FFFFFF' }, name: 'Arial' }, 
      fill: { fgColor: { rgb: '0F172A' }, patternType: 'solid' }, 
      alignment: { horizontal: 'center', vertical: 'center' } 
    }
    const companyStyle = { 
      font: { bold: true, sz: 14, color: { rgb: '0F172A' }, name: 'Arial' }, 
      alignment: { horizontal: 'center', vertical: 'center' } 
    }
    const periodStyle = { 
      font: { sz: 11, color: { rgb: '64748B' }, name: 'Arial' }, 
      alignment: { horizontal: 'center', vertical: 'center' } 
    }
    const headerStyle = { 
      font: { bold: true, sz: 12, color: { rgb: 'FFFFFF' }, name: 'Arial' }, 
      fill: { fgColor: { rgb: '1E40AF' }, patternType: 'solid' }, 
      alignment: { horizontal: 'center', vertical: 'center' }, 
      border: { 
        top: { style: 'medium', color: { rgb: '0F172A' } }, 
        bottom: { style: 'medium', color: { rgb: '0F172A' } }, 
        left: { style: 'medium', color: { rgb: '0F172A' } }, 
        right: { style: 'medium', color: { rgb: '0F172A' } } 
      } 
    }
    const sectionStyle = (bg: string, color: string) => ({ 
      font: { bold: true, sz: 13, color: { rgb: color }, name: 'Arial' }, 
      fill: { fgColor: { rgb: bg }, patternType: 'solid' }, 
      alignment: { horizontal: 'left', vertical: 'center' }, 
      border: { 
        top: { style: 'thick', color: { rgb: '0F172A' } }, 
        bottom: { style: 'thick', color: { rgb: '0F172A' } } 
      } 
    })
    const dataStyle = (bg: string) => ({ 
      font: { sz: 11, name: 'Arial' }, 
      fill: { fgColor: { rgb: bg }, patternType: 'solid' }, 
      border: { 
        top: { style: 'thin', color: { rgb: 'CBD5E1' } }, 
        bottom: { style: 'thin', color: { rgb: 'CBD5E1' } }, 
        left: { style: 'thin', color: { rgb: 'CBD5E1' } }, 
        right: { style: 'thin', color: { rgb: 'CBD5E1' } } 
      } 
    })
    const totalStyle = (bg: string, color: string) => ({ 
      font: { bold: true, sz: 13, color: { rgb: color }, name: 'Arial' }, 
      fill: { fgColor: { rgb: bg }, patternType: 'solid' }, 
      alignment: { horizontal: 'right', vertical: 'center' }, 
      numFmt: '#,##0.000', 
      border: { 
        top: { style: 'thick', color: { rgb: '0F172A' } }, 
        bottom: { style: 'thick', color: { rgb: '0F172A' } } 
      } 
    })
    const totalLabelStyle = (bg: string, color: string) => ({ 
      font: { bold: true, sz: 13, color: { rgb: color }, name: 'Arial' }, 
      fill: { fgColor: { rgb: bg }, patternType: 'solid' }, 
      alignment: { horizontal: 'left', vertical: 'center' }, 
      border: { 
        top: { style: 'thick', color: { rgb: '0F172A' } }, 
        bottom: { style: 'thick', color: { rgb: '0F172A' } } 
      } 
    })

    // ====== SHEET DATA ======
    const wsData: any[] = [
      [{ v: 'PROFIT & LOSS STATEMENT', s: titleStyle }, { v: '', s: titleStyle }],
      [{ v: 'Harbour Consultancies W.L.L', s: companyStyle }, { v: '', s: companyStyle }],
      [{ v: 'Period: ' + fromDate + '  to  ' + toDate, s: periodStyle }, { v: '', s: periodStyle }],
      [{ v: '', s: {} }, { v: '', s: {} }],
      [{ v: 'Item', s: headerStyle }, { v: 'Amount (BHD)', s: headerStyle }]
    ]

    let rowIdx = 0

    // REVENUE
    wsData.push([{ v: 'REVENUE', s: sectionStyle('DBEAFE', '1E40AF') }, { v: '', s: sectionStyle('DBEAFE', '1E40AF') }])
    revenues.forEach(r => {
      wsData.push([
        { v: '    ' + r.name, s: dataStyle(rowIdx % 2 === 0 ? 'FFFFFF' : 'F8FAFC') },
        { v: r.amount, s: { ...dataStyle(rowIdx % 2 === 0 ? 'FFFFFF' : 'F8FAFC'), alignment: { horizontal: 'right' }, numFmt: '#,##0.000' } }
      ])
      rowIdx++
    })
    wsData.push([{ v: 'Total Revenue', s: totalLabelStyle('BFDBFE', '1E40AF') }, { v: totalRevenue, s: totalStyle('BFDBFE', '1E40AF') }])

    // COST OF SALES
    if (cos.length > 0) {
      wsData.push([{ v: '', s: {} }, { v: '', s: {} }])
      wsData.push([{ v: 'COST OF SALES', s: sectionStyle('FEF3C7', '92400E') }, { v: '', s: sectionStyle('FEF3C7', '92400E') }])
      cos.forEach(r => {
        wsData.push([
          { v: '    ' + r.name, s: dataStyle(rowIdx % 2 === 0 ? 'FFFFFF' : 'F8FAFC') },
          { v: r.amount, s: { ...dataStyle(rowIdx % 2 === 0 ? 'FFFFFF' : 'F8FAFC'), alignment: { horizontal: 'right' }, numFmt: '#,##0.000' } }
        ])
        rowIdx++
      })
      wsData.push([{ v: 'Total Cost of Sales', s: totalLabelStyle('FDE68A', '92400E') }, { v: totalCos, s: totalStyle('FDE68A', '92400E') }])
    }

    // GROSS PROFIT
    wsData.push([{ v: '', s: {} }, { v: '', s: {} }])
    wsData.push([{ v: 'GROSS PROFIT', s: totalLabelStyle('D1FAE5', '065F46') }, { v: grossProfit, s: totalStyle('D1FAE5', '065F46') }])

    // OPERATING EXPENSES
    if (opex.length > 0) {
      wsData.push([{ v: '', s: {} }, { v: '', s: {} }])
      wsData.push([{ v: 'OPERATING EXPENSES', s: sectionStyle('FEE2E2', '991B1B') }, { v: '', s: sectionStyle('FEE2E2', '991B1B') }])
      opex.forEach(r => {
        wsData.push([
          { v: '    ' + r.name, s: dataStyle(rowIdx % 2 === 0 ? 'FFFFFF' : 'F8FAFC') },
          { v: r.amount, s: { ...dataStyle(rowIdx % 2 === 0 ? 'FFFFFF' : 'F8FAFC'), alignment: { horizontal: 'right' }, numFmt: '#,##0.000' } }
        ])
        rowIdx++
      })
    }

    // ADMIN EXPENSES
    if (admin.length > 0) {
      wsData.push([{ v: '', s: {} }, { v: '', s: {} }])
      wsData.push([{ v: 'ADMINISTRATIVE EXPENSES', s: sectionStyle('FEE2E2', '991B1B') }, { v: '', s: sectionStyle('FEE2E2', '991B1B') }])
      admin.forEach(r => {
        wsData.push([
          { v: '    ' + r.name, s: dataStyle(rowIdx % 2 === 0 ? 'FFFFFF' : 'F8FAFC') },
          { v: r.amount, s: { ...dataStyle(rowIdx % 2 === 0 ? 'FFFFFF' : 'F8FAFC'), alignment: { horizontal: 'right' }, numFmt: '#,##0.000' } }
        ])
        rowIdx++
      })
    }

    // OTHER EXPENSES
    if (other.length > 0) {
      wsData.push([{ v: '', s: {} }, { v: '', s: {} }])
      wsData.push([{ v: 'OTHER EXPENSES', s: sectionStyle('FEE2E2', '991B1B') }, { v: '', s: sectionStyle('FEE2E2', '991B1B') }])
      other.forEach(r => {
        wsData.push([
          { v: '    ' + r.name, s: dataStyle(rowIdx % 2 === 0 ? 'FFFFFF' : 'F8FAFC') },
          { v: r.amount, s: { ...dataStyle(rowIdx % 2 === 0 ? 'FFFFFF' : 'F8FAFC'), alignment: { horizontal: 'right' }, numFmt: '#,##0.000' } }
        ])
        rowIdx++
      })
    }

    const totalExpenses = totalOpex + totalAdmin + totalOther
    if (totalExpenses > 0) {
      wsData.push([{ v: 'Total Expenses', s: totalLabelStyle('FECACA', '991B1B') }, { v: totalExpenses, s: totalStyle('FECACA', '991B1B') }])
    }

    // NET PROFIT
    wsData.push([{ v: '', s: {} }, { v: '', s: {} }])
    const netColor = netProfit >= 0 ? '065F46' : '991B1B'
    const netBg = netProfit >= 0 ? 'BBF7D0' : 'FECACA'
    wsData.push([{ v: 'NET PROFIT', s: totalLabelStyle(netBg, netColor) }, { v: netProfit, s: totalStyle(netBg, netColor) }])
    wsData.push([{ v: 'Profit Margin', s: totalLabelStyle(netBg, netColor) }, { v: profitMargin.toFixed(1) + '%', s: { ...totalStyle(netBg, netColor), numFmt: '0.0"%"' } }])

    const ws = XLSX.utils.aoa_to_sheet(wsData)
    ws['!cols'] = [{ wch: 55 }, { wch: 22 }]
    ws['!merges'] = [
      { s: { r: 0, c: 0 }, e: { r: 0, c: 1 } },
      { s: { r: 1, c: 0 }, e: { r: 1, c: 1 } },
      { s: { r: 2, c: 0 }, e: { r: 2, c: 1 } }
    ]

    XLSX.utils.book_append_sheet(wb, ws, 'Profit & Loss')
    XLSX.writeFile(wb, 'Profit_Loss_' + fromDate + '_to_' + toDate + '.xlsx')
  }

  const renderRow = (r: PLRow, amountColor: string) => (
    <div 
      key={r.code} 
      className="group flex justify-between items-center py-2.5 px-3 rounded-lg hover:bg-slate-100 cursor-pointer transition-all border border-transparent hover:border-slate-200"
      onClick={() => showJournalEntries(r.account_id, isRTL ? r.name_ar : r.name, r.code)}
    >
      <div className="flex items-center gap-3">
        <div className="w-8 h-8 rounded-lg bg-slate-100 group-hover:bg-blue-100 flex items-center justify-center transition-colors">
          <Eye className="w-4 h-4 text-slate-400 group-hover:text-blue-600" />
        </div>
        <div>
          <p className="text-sm font-semibold text-slate-800 group-hover:text-blue-700 transition-colors">{isRTL ? r.name_ar : r.name}</p>
          <p className="text-xs text-slate-400 font-mono">{r.code}</p>
        </div>
      </div>
      <p className={'text-sm font-bold ' + amountColor + ' font-mono'}>{r.amount.toFixed(3)} BHD</p>
    </div>
  )

  return (
    <DashboardLayout>
      <div className="min-h-screen bg-[#f0f2f5]" dir={isRTL ? "rtl" : "ltr"}>
        <div className="p-6 max-w-5xl mx-auto space-y-6">
          {/* HEADER */}
          <div className="flex items-center justify-between print:hidden">
            <div className="flex items-center gap-4">
              <Button variant="outline" size="icon" onClick={() => router.back()} className="rounded-lg"><ArrowLeft className={isRTL ? 'rotate-180' : ''} /></Button>
              <div>
                <h1 className="text-2xl font-black text-slate-900">{isRTL ? 'قائمة الدخل' : 'Profit & Loss Statement'}</h1>
                <p className="text-sm text-slate-500">{isRTL ? 'الإيرادات والمصروفات وصافي الربح' : 'Revenues, expenses and net profit'}</p>
              </div>
            </div>
            <div className="flex gap-2">
              <Button onClick={handlePrint} variant="outline" className="rounded-xl">
                <Printer className="w-4 h-4 mr-2" />{isRTL ? 'طباعة' : 'Print'}
              </Button>
              <Button onClick={exportExcel} className="bg-emerald-600 hover:bg-emerald-700 rounded-xl">
                <Download className="w-4 h-4 mr-2" />{isRTL ? 'تصدير Excel' : 'Export Excel'}
              </Button>
            </div>
          </div>

          {/* PRINT HEADER */}
          <div className="hidden print:block text-center mb-6">
            <h1 className="text-3xl font-black text-slate-900">Profit & Loss Report</h1>
            <p className="text-slate-500 mt-2">Period: {fromDate} to {toDate}</p>
            <hr className="mt-4 border-slate-300" />
          </div>

          {/* DATE FILTER */}
          <Card className="border-0 shadow-md print:hidden">
            <CardContent className="p-4">
              <div className="flex flex-col md:flex-row gap-4">
                <div className="flex-1">
                  <Label className="text-xs text-slate-500 mb-1 block">{isRTL ? 'من' : 'From'}</Label>
                  <div className="relative"><Calendar className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" /><Input type="date" value={fromDate} onChange={e => setFromDate(e.target.value)} className="pl-10 rounded-lg" /></div>
                </div>
                <div className="flex-1">
                  <Label className="text-xs text-slate-500 mb-1 block">{isRTL ? 'إلى' : 'To'}</Label>
                  <div className="relative"><Calendar className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" /><Input type="date" value={toDate} onChange={e => setToDate(e.target.value)} className="pl-10 rounded-lg" /></div>
                </div>
              </div>
            </CardContent>
          </Card>

          {/* SUMMARY CARDS */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4 print:hidden">
            <Card className="border-0 shadow-md bg-gradient-to-br from-emerald-50 to-white">
              <CardContent className="p-4">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center"><TrendingUp className="w-5 h-5 text-emerald-600" /></div>
                  <div><p className="text-xs text-slate-500">{isRTL ? 'إجمالي الإيرادات' : 'Total Revenue'}</p><p className="text-xl font-black text-emerald-600">{totalRevenue.toFixed(3)} BHD</p></div>
                </div>
              </CardContent>
            </Card>
            <Card className="border-0 shadow-md bg-gradient-to-br from-red-50 to-white">
              <CardContent className="p-4">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center"><TrendingDown className="w-5 h-5 text-red-600" /></div>
                  <div><p className="text-xs text-slate-500">{isRTL ? 'إجمالي المصروفات' : 'Total Expenses'}</p><p className="text-xl font-black text-red-600">{(totalOpex + totalAdmin + totalOther).toFixed(3)} BHD</p></div>
                </div>
              </CardContent>
            </Card>
            <Card className={'border-0 shadow-md ' + (netProfit >= 0 ? 'bg-gradient-to-br from-blue-50 to-white' : 'bg-gradient-to-br from-amber-50 to-white')}>
              <CardContent className="p-4">
                <div className="flex items-center gap-3">
                  <div className={'w-10 h-10 rounded-xl flex items-center justify-center ' + (netProfit >= 0 ? 'bg-blue-100' : 'bg-amber-100')}>{netProfit >= 0 ? <TrendingUp className="w-5 h-5 text-blue-600" /> : <Minus className="w-5 h-5 text-amber-600" />}</div>
                  <div>
                    <p className="text-xs text-slate-500">{isRTL ? 'صافي الربح' : 'Net Profit'}</p>
                    <p className={'text-xl font-black ' + (netProfit >= 0 ? 'text-blue-600' : 'text-amber-600')}>{netProfit.toFixed(3)} BHD</p>
                    <Badge className={'mt-1 text-[10px] ' + (netProfit >= 0 ? 'bg-blue-100 text-blue-700' : 'bg-amber-100 text-amber-700')}>{profitMargin.toFixed(1)}% {isRTL ? 'هامش ربح' : 'Margin'}</Badge>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>

          {/* P&L DETAILS */}
          <Card className="border-0 shadow-md overflow-hidden print:shadow-none print:border print:border-slate-300">
            <CardHeader className="bg-gradient-to-r from-slate-900 to-slate-800 text-white print:bg-white print:text-slate-900 print:border-b print:border-slate-300">
              <CardTitle className="flex items-center gap-2 text-base"><TrendingUp className="w-5 h-5" />{isRTL ? 'تفاصيل قائمة الدخل' : 'Profit & Loss Details'}</CardTitle>
            </CardHeader>
            <CardContent className="p-0">
              {loading ? <div className="p-8 text-center text-slate-400">{isRTL ? 'جاري التحميل...' : 'Loading...'}</div> : (
                <div className="p-6 space-y-6">
                  {/* REVENUE */}
                  <div>
                    <div className="flex items-center gap-2 mb-3 pb-2 border-b-2 border-emerald-300 bg-emerald-50 px-3 py-2 rounded-lg print:bg-white print:border-slate-300">
                      <TrendingUp className="w-5 h-5 text-emerald-600" />
                      <h3 className="text-lg font-bold text-emerald-700">{isRTL ? 'الإيرادات' : 'REVENUE'}</h3>
                    </div>
                    {revenues.length === 0 ? <p className="text-sm text-slate-400 py-2 px-3">{isRTL ? 'لا توجد إيرادات' : 'No revenues'}</p> : (
                      <div className="space-y-1">
                        {revenues.map(r => renderRow(r, 'text-emerald-600'))}
                        <div className="flex justify-between items-center py-3 px-3 bg-emerald-50 rounded-xl mt-2 border-t-2 border-emerald-200 print:bg-white print:border-slate-300">
                          <p className="text-sm font-bold text-emerald-800">{isRTL ? 'إجمالي الإيرادات' : 'Total Revenue'}</p>
                          <p className="text-lg font-black text-emerald-700 font-mono">{totalRevenue.toFixed(3)} BHD</p>
                        </div>
                      </div>
                    )}
                  </div>

                  {/* COST OF SALES */}
                  {cos.length > 0 && (
                    <div>
                      <div className="flex items-center gap-2 mb-3 pb-2 border-b-2 border-amber-300 bg-amber-50 px-3 py-2 rounded-lg print:bg-white print:border-slate-300">
                        <TrendingDown className="w-5 h-5 text-amber-600" />
                        <h3 className="text-lg font-bold text-amber-700">{isRTL ? 'تكلفة المبيعات' : 'COST OF SALES'}</h3>
                      </div>
                      <div className="space-y-1">
                        {cos.map(r => renderRow(r, 'text-amber-600'))}
                        <div className="flex justify-between items-center py-3 px-3 bg-amber-50 rounded-xl mt-2 border-t-2 border-amber-200 print:bg-white print:border-slate-300">
                          <p className="text-sm font-bold text-amber-800">{isRTL ? 'إجمالي التكلفة' : 'Total Costs'}</p>
                          <p className="text-lg font-black text-amber-700 font-mono">{totalCos.toFixed(3)} BHD</p>
                        </div>
                      </div>
                    </div>
                  )}

                  {/* GROSS PROFIT */}
                  <div className={'p-4 rounded-2xl ' + (grossProfit >= 0 ? 'bg-gradient-to-r from-emerald-50 to-blue-50 border border-emerald-200' : 'bg-gradient-to-r from-amber-50 to-red-50 border border-amber-200') + ' print:bg-white print:border-slate-300'}>
                    <div className="flex justify-between items-center">
                      <div><p className="text-sm font-bold text-slate-700">{isRTL ? 'مجمل الربح' : 'Gross Profit'}</p><p className="text-xs text-slate-500">{isRTL ? 'الإيرادات - تكلفة المبيعات' : 'Revenue - Cost of Sales'}</p></div>
                      <p className={'text-2xl font-black font-mono ' + (grossProfit >= 0 ? 'text-emerald-600' : 'text-red-600')}>{grossProfit >= 0 ? '+' : ''}{grossProfit.toFixed(3)} BHD</p>
                    </div>
                  </div>

                  {/* EXPENSES */}
                  {opex.length > 0 && (
                    <div>
                      <div className="flex items-center gap-2 mb-3 pb-2 border-b-2 border-red-300 bg-red-50 px-3 py-2 rounded-lg print:bg-white print:border-slate-300">
                        <TrendingDown className="w-5 h-5 text-red-600" />
                        <h3 className="text-lg font-bold text-red-700">{isRTL ? 'مصاريف التشغيل' : 'OPERATING EXPENSES'}</h3>
                      </div>
                      <div className="space-y-1">{opex.map(r => renderRow(r, 'text-red-600'))}</div>
                    </div>
                  )}

                  {admin.length > 0 && (
                    <div>
                      <div className="flex items-center gap-2 mb-3 pb-2 border-b-2 border-red-300 bg-red-50 px-3 py-2 rounded-lg print:bg-white print:border-slate-300">
                        <TrendingDown className="w-5 h-5 text-red-600" />
                        <h3 className="text-lg font-bold text-red-700">{isRTL ? 'مصاريف إدارية' : 'ADMIN EXPENSES'}</h3>
                      </div>
                      <div className="space-y-1">{admin.map(r => renderRow(r, 'text-red-600'))}</div>
                    </div>
                  )}

                  {other.length > 0 && (
                    <div>
                      <div className="flex items-center gap-2 mb-3 pb-2 border-b-2 border-red-300 bg-red-50 px-3 py-2 rounded-lg print:bg-white print:border-slate-300">
                        <TrendingDown className="w-5 h-5 text-red-600" />
                        <h3 className="text-lg font-bold text-red-700">{isRTL ? 'مصاريف أخرى' : 'OTHER EXPENSES'}</h3>
                      </div>
                      <div className="space-y-1">{other.map(r => renderRow(r, 'text-red-600'))}</div>
                    </div>
                  )}

                  {(totalOpex + totalAdmin + totalOther) > 0 && (
                    <div className="flex justify-between items-center py-3 px-3 bg-red-50 rounded-xl border-t-2 border-red-200 print:bg-white print:border-slate-300">
                      <p className="text-sm font-bold text-red-800">{isRTL ? 'إجمالي المصروفات' : 'Total Expenses'}</p>
                      <p className="text-lg font-black text-red-700 font-mono">{(totalOpex + totalAdmin + totalOther).toFixed(3)} BHD</p>
                    </div>
                  )}

                  {/* NET PROFIT */}
                  <div className={'p-4 rounded-2xl ' + (netProfit >= 0 ? 'bg-gradient-to-r from-blue-50 to-emerald-50 border border-blue-200' : 'bg-gradient-to-r from-amber-50 to-red-50 border border-amber-200') + ' print:bg-white print:border-slate-300'}>
                    <div className="flex justify-between items-center">
                      <div><p className="text-sm font-bold text-slate-700">{isRTL ? 'صافي الربح / الخسارة' : 'Net Profit / Loss'}</p><p className="text-xs text-slate-500">{isRTL ? 'مجمل الربح - المصروفات' : 'Gross Profit - Expenses'}</p></div>
                      <p className={'text-2xl font-black font-mono ' + (netProfit >= 0 ? 'text-emerald-600' : 'text-red-600')}>{netProfit >= 0 ? '+' : ''}{netProfit.toFixed(3)} BHD</p>
                    </div>
                  </div>

                  <div className="flex justify-between items-center py-3 px-3 bg-slate-50 rounded-xl border border-slate-200 print:bg-white print:border-slate-300">
                    <p className="text-sm font-bold text-slate-800">{isRTL ? 'هامش الربح' : 'Profit Margin'}</p>
                    <p className="text-lg font-black text-slate-700 font-mono">{profitMargin.toFixed(1)}%</p>
                  </div>
                </div>
              )}
            </CardContent>
          </Card>
        </div>
      </div>

      {/* DIALOG */}
      <Dialog open={dialogOpen} onOpenChange={setDialogOpen}>
        <DialogContent className="max-w-4xl max-h-[85vh] overflow-hidden p-0 gap-0">
          <div className="bg-gradient-to-r from-slate-900 to-slate-800 text-white p-6">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-3">
                <div className="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center">
                  <FileText className="w-5 h-5" />
                </div>
                <div>
                  <h2 className="text-lg font-bold">{isRTL ? 'القيود اليومية' : 'Journal Entries'}</h2>
                  <p className="text-sm text-slate-300">{selectedAccountName} <span className="font-mono text-slate-400">({selectedAccountCode})</span></p>
                </div>
              </div>
              <Button variant="ghost" size="icon" onClick={() => setDialogOpen(false)} className="text-white hover:bg-white/10 rounded-lg">
                <X className="w-5 h-5" />
              </Button>
            </div>
          </div>

          <div className="p-6 overflow-y-auto max-h-[60vh]">
            {dialogLoading ? (
              <div className="flex flex-col items-center justify-center py-12">
                <div className="w-8 h-8 border-2 border-slate-200 border-t-blue-600 rounded-full animate-spin mb-4"></div>
                <p className="text-slate-400">{isRTL ? 'جاري التحميل...' : 'Loading journal entries...'}</p>
              </div>
            ) : journalLines.length === 0 ? (
              <div className="flex flex-col items-center justify-center py-12 text-slate-400">
                <FileText className="w-12 h-12 mb-4 opacity-30" />
                <p className="text-lg font-medium">{isRTL ? 'لا توجد قيود' : 'No journal entries found'}</p>
                <p className="text-sm">{isRTL ? 'لا توجد حركات لهذا الحساب في الفترة المحددة' : 'No transactions for this account in the selected period'}</p>
              </div>
            ) : (
              <div className="space-y-3">
                {journalLines.map((line, i) => (
                  <div key={i} className="bg-white border border-slate-200 rounded-xl p-4 hover:shadow-md transition-shadow">
                    <div className="flex items-center justify-between mb-3">
                      <div className="flex items-center gap-3">
                        <Badge variant="outline" className="font-mono text-xs bg-slate-50">
                          {line.journal_entries?.journal_number || '-'}
                        </Badge>
                        <span className="text-sm text-slate-500">{line.journal_entries?.entry_date || '-'}</span>
                      </div>
                      <div className="flex gap-2">
                        {line.debit > 0 && <Badge className="bg-blue-100 text-blue-700 text-xs">DEBIT</Badge>}
                        {line.credit > 0 && <Badge className="bg-emerald-100 text-emerald-700 text-xs">CREDIT</Badge>}
                      </div>
                    </div>
                    <p className="text-sm font-medium text-slate-800 mb-3">{line.description || line.journal_entries?.description || '-'}</p>
                    <div className="flex gap-4 bg-slate-50 rounded-lg p-3">
                      <div className="flex-1">
                        <p className="text-xs text-slate-400 uppercase mb-1">{isRTL ? 'مدين' : 'Debit'}</p>
                        <p className="text-lg font-bold font-mono text-blue-600">{line.debit > 0 ? line.debit.toFixed(3) + ' BHD' : '-'}</p>
                      </div>
                      <div className="w-px bg-slate-200"></div>
                      <div className="flex-1">
                        <p className="text-xs text-slate-400 uppercase mb-1">{isRTL ? 'دائن' : 'Credit'}</p>
                        <p className="text-lg font-bold font-mono text-emerald-600">{line.credit > 0 ? line.credit.toFixed(3) + ' BHD' : '-'}</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>

          <div className="border-t border-slate-200 p-4 bg-slate-50 flex justify-between items-center">
            <p className="text-xs text-slate-400">
              {journalLines.length} {isRTL ? 'قيود' : 'entries found'}
            </p>
            <Button onClick={() => setDialogOpen(false)} variant="outline" className="rounded-lg">
              {isRTL ? 'إغلاق' : 'Close'}
            </Button>
          </div>
        </DialogContent>
      </Dialog>
    </DashboardLayout>
  )
}

export default function ProfitLossPage() {
  return (
    <Suspense fallback={<div className="min-h-screen bg-[#f0f2f5] flex items-center justify-center"><div className="w-10 h-10 bg-slate-800 rounded-xl animate-pulse" /></div>}>
      <ProfitLossContent />
    </Suspense>
  )
}
