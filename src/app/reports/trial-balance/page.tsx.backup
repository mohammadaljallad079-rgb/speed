"use client"
import { Suspense, useState, useEffect } from 'react'
export const dynamic = "force-dynamic"
import { supabase } from '@/lib/supabase'
import DashboardLayout from '@/components/DashboardLayout'
import { useLanguage } from '@/lib/LanguageContext'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { Badge } from '@/components/ui/badge'
import { Scale, Download, Calendar, Search, ArrowLeft } from 'lucide-react'
import { useRouter } from 'next/navigation'
import * as XLSX from 'xlsx'

interface TrialBalanceRow {
  account_code: string
  account_name: string
  account_name_ar: string
  account_type: string
  debit: number
  credit: number
  balance: number
}

function TrialBalanceContent() {
  const { isRTL } = useLanguage()
  const router = useRouter()
  const [data, setData] = useState<TrialBalanceRow[]>([])
  const [loading, setLoading] = useState(true)
  const [asOfDate, setAsOfDate] = useState(new Date().toISOString().split('T')[0])
  const [searchTerm, setSearchTerm] = useState('')
  const [totalDebit, setTotalDebit] = useState(0)
  const [totalCredit, setTotalCredit] = useState(0)

  useEffect(() => {
    loadData()
  }, [asOfDate])

  async function loadData() {
    setLoading(true)
    try {
      const { data: accounts } = await supabase
        .from('chart_of_accounts')
        .select('*')
        .order('account_code')

      const { data: entries } = await supabase
        .from('journal_entries')
        .select('*')
        .lte('date', asOfDate)

      const rows: TrialBalanceRow[] = (accounts || []).map((acc: any) => {
        const accEntries = (entries || []).filter((e: any) => e.account_id === acc.id)
        const debit = accEntries.reduce((s: number, e: any) => s + Number(e.debit || 0), 0)
        const credit = accEntries.reduce((s: number, e: any) => s + Number(e.credit || 0), 0)
        const balance = debit - credit
        return {
          account_code: acc.account_code || '',
          account_name: acc.account_name || '',
          account_name_ar: acc.account_name_ar || acc.account_name || '',
          account_type: acc.account_type || '',
          debit,
          credit,
          balance
        }
      }).filter((r: TrialBalanceRow) => r.debit !== 0 || r.credit !== 0)

      setData(rows)
      setTotalDebit(rows.reduce((s, r) => s + r.debit, 0))
      setTotalCredit(rows.reduce((s, r) => s + r.credit, 0))
    } catch (err) {
      console.error(err)
    } finally {
      setLoading(false)
    }
  }

  const filteredData = data.filter(r =>
    r.account_code.toLowerCase().includes(searchTerm.toLowerCase()) ||
    r.account_name.toLowerCase().includes(searchTerm.toLowerCase()) ||
    r.account_name_ar.includes(searchTerm)
  )

  function exportExcel() {
    const exportData = filteredData.map(r => ({
      'Account Code': r.account_code,
      'Account Name': r.account_name,
      'Account Name AR': r.account_name_ar,
      'Type': r.account_type,
      'Debit (BHD)': r.debit,
      'Credit (BHD)': r.credit,
      'Balance (BHD)': r.balance
    }))
    exportData.push({
      'Account Code': '',
      'Account Name': 'TOTAL',
      'Account Name AR': 'الإجمالي',
      'Type': '',
      'Debit (BHD)': totalDebit,
      'Credit (BHD)': totalCredit,
      'Balance (BHD)': totalDebit - totalCredit
    })
    const ws = XLSX.utils.json_to_sheet(exportData)
    const wb = XLSX.utils.book_new()
    XLSX.utils.book_append_sheet(wb, ws, 'Trial Balance')
    XLSX.writeFile(wb, `Trial_Balance_${asOfDate}.xlsx`)
  }

  const typeColors: Record<string, string> = {
    asset: 'bg-blue-100 text-blue-700',
    liability: 'bg-red-100 text-red-700',
    equity: 'bg-violet-100 text-violet-700',
    revenue: 'bg-emerald-100 text-emerald-700',
    expense: 'bg-amber-100 text-amber-700'
  }

  return (
    <DashboardLayout>
      <div className="min-h-screen bg-[#f0f2f5]" dir={isRTL ? "rtl" : "ltr"}>
        <div className="p-6 max-w-7xl mx-auto space-y-6">
          {/* Header */}
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-4">
              <Button variant="outline" size="icon" onClick={() => router.back()} className="rounded-lg">
                <ArrowLeft className={isRTL ? 'rotate-180' : ''} />
              </Button>
              <div>
                <h1 className="text-2xl font-black text-slate-900">
                  {isRTL ? 'ميزان المراجعة' : 'Trial Balance'}
                </h1>
                <p className="text-sm text-slate-500">
                  {isRTL ? 'الأرصدة المدينة والدائنة لجميع الحسابات' : 'Debit and credit balances for all accounts'}
                </p>
              </div>
            </div>
            <Button onClick={exportExcel} className="bg-emerald-600 hover:bg-emerald-700 rounded-xl">
              <Download className="w-4 h-4 mr-2" />
              {isRTL ? 'تصدير Excel' : 'Export Excel'}
            </Button>
          </div>

          {/* Filters */}
          <Card className="border-0 shadow-md">
            <CardContent className="p-4">
              <div className="flex flex-col md:flex-row gap-4">
                <div className="flex-1">
                  <Label className="text-xs text-slate-500 mb-1 block">
                    {isRTL ? 'البحث' : 'Search'}
                  </Label>
                  <div className="relative">
                    <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
                    <Input
                      placeholder={isRTL ? 'ابحث بحساب...' : 'Search account...'}
                      value={searchTerm}
                      onChange={e => setSearchTerm(e.target.value)}
                      className="pl-10 rounded-lg"
                    />
                  </div>
                </div>
                <div>
                  <Label className="text-xs text-slate-500 mb-1 block">
                    {isRTL ? 'تاريخ' : 'As of Date'}
                  </Label>
                  <div className="relative">
                    <Calendar className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
                    <Input
                      type="date"
                      value={asOfDate}
                      onChange={e => setAsOfDate(e.target.value)}
                      className="pl-10 rounded-lg"
                    />
                  </div>
                </div>
              </div>
            </CardContent>
          </Card>

          {/* Summary Cards */}
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <Card className="border-0 shadow-md bg-gradient-to-br from-blue-50 to-white">
              <CardContent className="p-4">
                <p className="text-xs text-slate-500">{isRTL ? 'إجمالي المدين' : 'Total Debit'}</p>
                <p className="text-2xl font-black text-blue-600">{totalDebit.toFixed(3)} BHD</p>
              </CardContent>
            </Card>
            <Card className="border-0 shadow-md bg-gradient-to-br from-red-50 to-white">
              <CardContent className="p-4">
                <p className="text-xs text-slate-500">{isRTL ? 'إجمالي الدائن' : 'Total Credit'}</p>
                <p className="text-2xl font-black text-red-600">{totalCredit.toFixed(3)} BHD</p>
              </CardContent>
            </Card>
            <Card className={`border-0 shadow-md ${Math.abs(totalDebit - totalCredit) < 0.01 ? 'bg-gradient-to-br from-emerald-50 to-white' : 'bg-gradient-to-br from-amber-50 to-white'}`}>
              <CardContent className="p-4">
                <p className="text-xs text-slate-500">{isRTL ? 'الفرق' : 'Difference'}</p>
                <p className={`text-2xl font-black ${Math.abs(totalDebit - totalCredit) < 0.01 ? 'text-emerald-600' : 'text-amber-600'}`}>
                  {(totalDebit - totalCredit).toFixed(3)} BHD
                </p>
                {Math.abs(totalDebit - totalCredit) < 0.01 && (
                  <Badge className="mt-2 bg-emerald-100 text-emerald-700">{isRTL ? 'متوازن' : 'Balanced'}</Badge>
                )}
              </CardContent>
            </Card>
          </div>

          {/* Table */}
          <Card className="border-0 shadow-md overflow-hidden">
            <CardHeader className="bg-gradient-to-r from-slate-900 to-slate-800 text-white">
              <CardTitle className="flex items-center gap-2 text-base">
                <Scale className="w-5 h-5" />
                {isRTL ? 'تفاصيل ميزان المراجعة' : 'Trial Balance Details'}
              </CardTitle>
            </CardHeader>
            <CardContent className="p-0">
              {loading ? (
                <div className="p-8 text-center text-slate-400">{isRTL ? 'جاري التحميل...' : 'Loading...'}</div>
              ) : filteredData.length === 0 ? (
                <div className="p-8 text-center text-slate-400">{isRTL ? 'لا توجد بيانات' : 'No data'}</div>
              ) : (
                <div className="overflow-x-auto">
                  <table className="w-full">
                    <thead>
                      <tr className="border-b border-slate-100 bg-slate-50">
                        <th className="text-start px-4 py-3 text-xs font-bold text-slate-500 uppercase">{isRTL ? 'الكود' : 'Code'}</th>
                        <th className="text-start px-4 py-3 text-xs font-bold text-slate-500 uppercase">{isRTL ? 'الحساب' : 'Account'}</th>
                        <th className="text-start px-4 py-3 text-xs font-bold text-slate-500 uppercase">{isRTL ? 'النوع' : 'Type'}</th>
                        <th className="text-end px-4 py-3 text-xs font-bold text-slate-500 uppercase">{isRTL ? 'مدين' : 'Debit'}</th>
                        <th className="text-end px-4 py-3 text-xs font-bold text-slate-500 uppercase">{isRTL ? 'دائن' : 'Credit'}</th>
                        <th className="text-end px-4 py-3 text-xs font-bold text-slate-500 uppercase">{isRTL ? 'الرصيد' : 'Balance'}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {filteredData.map((row, i) => (
                        <tr key={i} className="border-b border-slate-50 hover:bg-slate-50/50">
                          <td className="px-4 py-3 text-sm font-mono text-slate-600">{row.account_code}</td>
                          <td className="px-4 py-3">
                            <p className="text-sm font-semibold text-slate-800">{isRTL ? row.account_name_ar : row.account_name}</p>
                            <p className="text-xs text-slate-400">{isRTL ? row.account_name : row.account_name_ar}</p>
                          </td>
                          <td className="px-4 py-3">
                            <span className={`text-[10px] font-bold px-2 py-1 rounded-full uppercase ${typeColors[row.account_type] || 'bg-slate-100 text-slate-600'}`}>
                              {row.account_type}
                            </span>
                          </td>
                          <td className="px-4 py-3 text-sm text-end font-mono text-slate-700">{row.debit > 0 ? row.debit.toFixed(3) : '-'}</td>
                          <td className="px-4 py-3 text-sm text-end font-mono text-slate-700">{row.credit > 0 ? row.credit.toFixed(3) : '-'}</td>
                          <td className="px-4 py-3 text-sm text-end font-mono font-bold text-slate-800">{row.balance.toFixed(3)}</td>
                        </tr>
                      ))}
                      <tr className="bg-slate-900 text-white font-bold">
                        <td className="px-4 py-3 text-sm" colSpan={3}>{isRTL ? 'الإجمالي' : 'TOTAL'}</td>
                        <td className="px-4 py-3 text-sm text-end font-mono">{totalDebit.toFixed(3)}</td>
                        <td className="px-4 py-3 text-sm text-end font-mono">{totalCredit.toFixed(3)}</td>
                        <td className="px-4 py-3 text-sm text-end font-mono">{(totalDebit - totalCredit).toFixed(3)}</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              )}
            </CardContent>
          </Card>
        </div>
      </div>
    </DashboardLayout>
  )
}

export default function TrialBalancePage() {
  return (
    <Suspense fallback={<div className="min-h-screen bg-[#f0f2f5] flex items-center justify-center"><div className="w-10 h-10 bg-slate-800 rounded-xl animate-pulse" /></div>}>
      <TrialBalanceContent />
    </Suspense>
  )
}
