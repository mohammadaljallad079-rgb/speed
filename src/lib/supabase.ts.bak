import { createClient } from "@supabase/supabase-js";

const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
const supabaseAnonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY;

if (!supabaseUrl || !supabaseAnonKey) {
  throw new Error("Missing Supabase environment variables");
}

export const supabase = createClient(supabaseUrl, supabaseAnonKey);

export type AppRole = "admin" | "staff" | "client";
export type CarCategory = "rental" | "sale" | "both";
export type CarStatus = "available" | "rented" | "sold" | "maintenance";

export type AppUser = {
  id: string;
  status: CarStatus;
  category: CarCategory;
  email: string | null;
  full_name: string | null;
  role: AppRole;
  customer_id: string | null;
};

export type Car = {
  id: string;
  status: CarStatus;
  category: CarCategory;
  make: string;
  model: string;
  year: number;
  color: string | null;
  plate_number: string;
  vin: string | null;

  location: string | null;
  daily_rate: number | null;
  weekly_rate: number | null;
  monthly_rate: number | null;
  sale_price: number | null;
  purchase_price: number | null;
  purchase_date: string | null;
  purchase_source: string | null;
  purchase_costs: number | null;
  maintenance_costs: number | null;
  mileage: number | null;
  fuel_type: string | null;
  transmission: string | null;
  seats: number | null;
  insurance_expiry: string | null;
  registration_expiry: string | null;
  image_url: string | null;
  features: string[] | null;
  notes: string | null;
  created_at: string | null;
  updated_at: string | null;
};


export type Customer = {
  id: string;
  status: CarStatus;
  category: CarCategory;
  full_name: string;
  email: string | null;
  phone: string;
  status?: string | null;
  phone_2?: string | null;
  national_id?: string | null;
  license_number?: string | null;
  nationality?: string | null;
  address?: string | null;
  city?: string | null;
  notes?: string | null;
  rating?: number | null;

};

export type RentalContract = {
  id: string;
  status: CarStatus;
  category: CarCategory;
  car_id: string | null;
  customer_id: string | null;
  start_date: string | null;
  end_date: string | null;
  status: string | null;
  total_amount: number | null;
  notes: string | null;
  pickup_location: string | null;
  dropoff_location: string | null;
  created_at: string | null;
  contract_number?: string | null;
  car?: Car | null;
  customer?: Customer | null;
  customers?: Customer | null;
};

export type Payment = {
  id: string;
  payment_number?: string | null;
  receipt_number?: string | null;
  payment_type?: string | null;
  invoice_id?: string | null;
  customer_id: string | null;
  amount: number | null;
  payment_date?: string | null;
  payment_method?: string | null;
  reference_number?: string | null;
  status: string | null;
  notes: string | null;
  created_at: string | null;
  customer?: Customer | null;
  customers?: Customer | null;
  invoice?: Invoice | null;
};

export type Invoice = {
  id: string;
  invoice_number?: string | null;
  customer_id: string | null;
  rental_contract_id?: string | null;
  amount: number | null;
  vat_amount?: number | null;
  total_amount?: number | null;
  status: string | null;
  issue_date?: string | null;
  invoice_date?: string | null;
  due_date?: string | null;
  paid_date?: string | null;
  notes: string | null;
  created_at: string | null;
  customer?: Customer | null;
  customers?: Customer | null;
  rental_contract?: RentalContract | null;
};

export type Expense = {
  id: string;
  description: string | null;
  amount: number | null;
  date: string | null;
  expense_date?: string | null;
  category: string | null;
  supplier_id: string | null;
  car_id: string | null;
  notes: string | null;
  status: string | null;
  created_at: string | null;
  supplier?: Supplier | null;
  car?: Car | null;
};

export type Supplier = {
  id: string;
  name: string;
  email: string | null;
  phone: string | null;
  address: string | null;
  notes: string | null;
  created_at: string | null;
};

export type Maintenance = {
  id: string;
  status: CarStatus;
  category: CarCategory;
  car_id: string;
  maintenance_type: string;
  service_date: string;
  next_service_date: string | null;
  cost: number;
  status: 'scheduled' | 'in_progress' | 'completed';
  vendor: string | null;
  notes: string | null;
  created_at: string | null;
  updated_at: string | null;
  contract_number?: string | null;
  car?: Car | null;
};
export const getAppUser = async (): Promise<{
  sessionUserId: string | null;
  appUser: AppUser | null;
}> => {
  const { data: sessionData, error: sessionError } =
    await supabase.auth.getSession();

  if (sessionError || !sessionData.session?.user) {
    return { sessionUserId: null, appUser: null };
  }

  const sessionUserId = sessionData.session.user.id;
  const { data: appUser, error } = await supabase
    .from("users")
    .select("id, email, full_name, role, customer_id")
    .eq("id", sessionUserId)
    .maybeSingle();

  if (error || !appUser) {
    return { sessionUserId, appUser: null };
  }

  return { sessionUserId, appUser: appUser as AppUser };
};
